# Copy to .env beside docker-compose.yml and provide a key for AI search.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Daily menu retrieval at 06:00 Europe/Zurich, plus initial backend startup.
MEAL_SCRAPER_ENABLED=true
MEAL_SCRAPER_MODEL=gpt-4.1-mini
MEAL_SCRAPER_CRON=0 0 6 * * *
# Docker reaches the connector running on the host. Local backend: http://127.0.0.1:8091
MEAL_CONNECTOR_URL=http://host.docker.internal:8091
MEAL_CONNECTOR_TOKEN=
