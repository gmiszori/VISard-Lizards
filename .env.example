# Copy to .env beside docker-compose.yml and provide a key for AI search.

# Optional AI search. Keep this value out of source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Public website port. Use 8083 locally if Eclipse already occupies 8080.
# Keep 8080 on the hackathon VM because its ingress forwards to that port.
WEB_PORT=8080
# Uncomment to include the MCP service with plain docker compose up.
# COMPOSE_PROFILES=scraper

# The Caddy frontend trusts X-Forwarded-* client IP headers from private proxy addresses.
# Replace with the hackathon proxy CIDR(s), space-separated, if its proxy uses public addresses.
CADDY_TRUSTED_PROXY_RANGES=private_ranges

# The bundled Kotlin MCP connector runs on the private Compose network.
# Enable automatic and cache-miss scraping after setting OPENAI_API_KEY.
MEAL_SCRAPER_ENABLED=false
MEAL_SCRAPER_MODEL=gpt-5-mini
MEAL_SCRAPER_CRON=0 0 6 * * *
# Generate with openssl rand -hex 32. Shared by backend and connector.
# Manual refresh requires at least 32 characters; the short demo default is rejected.
MEAL_CONNECTOR_TOKEN=
