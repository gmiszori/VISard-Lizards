# Copy to .env beside docker-compose.yml. For a public server, set DOMAIN to its DNS hostname
# and make sure ports 80 and 443 (TCP and UDP) can reach the server.
DOMAIN=:80

# Optional AI search. Keep this value out of source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# The dedicated menu scraper needs a separately deployed connector; live ETH menu import is separate.
MEAL_SCRAPER_ENABLED=false
MEAL_SCRAPER_MODEL=gpt-4.1-mini
MEAL_SCRAPER_CRON=0 0 6 * * *
# URL and token for the separately deployed connector, if enabling the scraper.
MEAL_CONNECTOR_URL=http://host.docker.internal:8091
MEAL_CONNECTOR_TOKEN=
