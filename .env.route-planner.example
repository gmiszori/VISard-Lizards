# Copy these variables into your ignored root .env. Never commit populated keys.
# Enable Routes API and Places API (New) in the Google Cloud project, with billing.
GOOGLE_MAPS_API_KEY=
# Separate public browser key: restrict to Maps JavaScript API and your website referrers.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Generate a separate private connector token, e.g. 32 random bytes as hex.
ROUTE_CONNECTOR_TOKEN=
ROUTE_PLANNER_MODEL=gpt-6-astra
ROUTE_WEB_PORT=8084
