# Copy into ignored root .env. Routing uses no Google key. The display needs a restricted Maps JavaScript browser key.
# Private secret shared by backend, Kotlin MCP bridge and OSM data adapter.
ROUTE_CONNECTOR_TOKEN=
ROUTE_PLANNER_MODEL=gpt-6-astra
ROUTE_WEB_PORT=8084
# Optional replacement/self-hosted provider endpoints.
OSM_FOOT_URL=http://osrm-foot:5000
SWISS_TRANSPORT_URL=https://transport.opendata.ch/v1
OSM_TRANSIT_GEOMETRY_URL=https://overpass.osm.ch/api/interpreter
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional Swiss OJP 2.0 key: service-specific train geometry, private adapter only.
OJP_API_KEY=
OJP_API_URL=https://api.opentransportdata.swiss/ojp20

# Display only; restrict to Maps JavaScript API and website referrers.
GOOGLE_MAPS_BROWSER_KEY=
