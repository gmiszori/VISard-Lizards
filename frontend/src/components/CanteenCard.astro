---
import type { AppCanteen } from '../data/app-data';
import MealPrice from './MealPrice.astro';
import MealStar from './MealStar.astro';
import RecipeAction from '../meals/RecipeAction.astro';
import ServiceLabel from './ServiceLabel.astro';
import LocationLink from './LocationLink.astro';
import CrowdIndicator from './CrowdIndicator.astro';
import { currentServiceLine, groupMenuByService, serviceWindowsForDate } from '../data/menu-display';
import { MENSAS } from '../data/canteens';
import { cuisineForDish, cuisineSearchText } from '../data/cuisine';
interface Props {
  canteen: AppCanteen;
  /** Set when the visitor picked a menu day: the canteen links open that day's menu. */
  day?: string;
  serviceDate: string;
  liveService?: boolean;
}
const { canteen, day, serviceDate, liveService = false } = Astro.props;
const canteenHref = day ? `/canteen/${canteen.id}/${day}` : `/canteen/${canteen.id}`;
const menuGroups = groupMenuByService(canteen.menu);
const initialService = currentServiceLine(serviceWindowsForDate(MENSAS.find(mensa => mensa.id === canteen.id), serviceDate), serviceDate).service;
---
<article data-canteen-card data-canteen-id={canteen.id} data-campus-id={canteen.campusId} data-is-open={String(canteen.isOpen)} data-has-menu={String(canteen.menu.length > 0)} data-has-photo={String(Boolean(canteen.imageUrl))} data-name={canteen.name} class="canteen-card">
  <div class="canteen-card-link">
    <div class="card-image">
      <a href={canteenHref} class="canteen-image-link" aria-label={canteen.name} hidden={!canteen.imageUrl}><img src={canteen.imageUrl} alt="" loading="lazy" onerror="this.hidden=true;" /></a>
      <div class="detail-overlay canteen-photo-caption">
        <div><div class="canteen-photo-title"><h3 class="card-title"><a href={canteenHref}>{canteen.name}</a></h3><button class="favorite-toggle" type="button" data-favorite-toggle aria-pressed="false" aria-label="Add to favourites"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.5 2.92 6.1 6.73.98-4.87 4.75 1.15 6.71L12 17.87l-5.93 3.17 1.13-6.71-4.87-4.75 6.74-.98L12 2.5Z" /></svg></button><span data-live="status" data-live-id={canteen.id} class={`status ${canteen.isOpen ? 'open' : 'closed'}`}>● <span data-i18n={canteen.isOpen ? 'open' : 'closed'}>{canteen.isOpen ? 'Open now' : 'Closed'}</span></span><CrowdIndicator mensaId={canteen.id} occupancy={canteen.isOpen ? canteen.occupancy : 'closed'} card /><LocationLink mensaId={canteen.id} /></div><div class="campus">{canteen.campus} <span aria-hidden="true">·</span> {canteen.location}</div></div>
      </div>
      {canteen.rating !== null && <span class="rating">★ {canteen.rating.toFixed(1)}</span>}
    </div>
  <div class="card-body">
    <div class="menu-preview" data-preference-list data-meal-list>
      {canteen.menu.length > 0 && <h4 class="meal-service-heading"><ServiceLabel mensaId={canteen.id} date={serviceDate} live={liveService} /></h4>}
      {menuGroups.map(group => <div class="meal-service-group" data-meal-group data-service={group.service} hidden={liveService && (initialService === 'closed' || (group.service !== undefined && !group.service.split(' ').includes(initialService)))}>
        {group.items.map((item) => <div class="dish-preview" data-diet={item.dietary} data-meal-row data-meal-name={item.name} data-search={[item.name, item.description, item.category, cuisineSearchText(cuisineForDish(item.id, item.name, item.description))].filter(Boolean).join(' ')}><div class="meal-preview-heading"><div class="dish"><a href={canteenHref}>{item.name}<span class={`diet diet-${item.dietary}`} data-i18n={`diet_${item.dietary}`}>{item.dietary}</span></a></div><RecipeAction item={item} /><MealStar item={item} /></div><MealPrice item={item} compact /></div>)}
      </div>)}
      <p class="preference-empty" data-no-preference-meals hidden data-i18n={canteen.menu.length ? 'noPreferenceMeals' : 'noDishesAvailable'}>{canteen.menu.length ? 'No dishes match your food preferences.' : 'No dishes available'}</p>
    </div>
    <a class="full-menu-link" data-preview-link href={canteenHref} hidden>View full menu</a>
  </div>
  </div>
</article>
<style>
  .canteen-card{align-self:start}.canteen-card .card-image{display:flex;align-items:flex-end;height:auto;min-height:110px}
  .canteen-card .canteen-image-link{position:absolute;inset:0}.canteen-card .canteen-image-link>img{width:100%;height:100%;object-fit:cover}
  .canteen-card .canteen-photo-caption{position:relative;inset:auto;width:100%;box-sizing:border-box;padding:44px 16px 10px;align-items:flex-end;pointer-events:none}
  .canteen-card .canteen-photo-caption :global(a){pointer-events:auto}
  .canteen-card .canteen-photo-caption :global(.favorite-toggle){pointer-events:auto}
  .canteen-photo-caption>div{width:100%;min-width:0}.canteen-photo-title{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
  .canteen-card .canteen-photo-caption .card-title{flex:0 1 auto;min-width:0;color:inherit;font-size:18px;line-height:1.2;overflow-wrap:anywhere}
  .canteen-card .canteen-photo-caption .campus{color:inherit;opacity:.85;font-size:11px;line-height:1.4;margin-top:5px}
  .canteen-card .canteen-photo-title .status{position:static;min-height:0;padding:5px 8px;font-size:10px;line-height:1.2;white-space:nowrap;box-shadow:none;flex-shrink:0}
  .canteen-card .rating{top:12px;left:12px;right:auto;bottom:auto}
  .canteen-card .card-body{padding:12px 16px 14px}
  .canteen-card .card-body>.menu-preview{border-top:0;padding:0;margin:0}
  .canteen-card .meal-service-group>.dish-preview{border-top:0;margin-top:0;padding-block:0}
  .canteen-card .meal-service-group>.dish-preview:not([hidden])~.dish-preview:not([hidden]){border-top:1px solid var(--line);margin-top:10px;padding-top:10px}
  .canteen-card .meal-service-group:not([hidden])~.meal-service-group:not([hidden]){border-top:1px solid var(--line);margin-top:13px;padding-top:10px}
  .canteen-card .meal-service-group[hidden]{display:none}
  .canteen-card .meal-service-heading{display:flex;align-items:center;gap:0;margin:0 0 8px;color:var(--muted);font-size:11px;font-weight:700;text-transform:uppercase}
  .canteen-card .meal-preview-heading{align-items:center}.canteen-card .meal-preview-heading>.dish{margin-top:0}
  .canteen-card .menu-preview>.preference-empty{margin:0;padding:8px 0;font-size:12px;line-height:1.5}
  .canteen-card .dish-preview.preview-clipped,.canteen-card .meal-service-group.preview-empty{display:none}
  .canteen-card .full-menu-link{display:flex;align-items:center;min-height:44px;margin-top:8px;border-top:1px solid var(--line);color:var(--green);font-size:12px;font-weight:700}
  .canteen-card .full-menu-link[hidden]{display:none}
  :root[data-density=compact] .canteen-card .card-image{height:auto;min-height:110px}
  :root[data-density=compact] .canteen-card .card-body{padding:10px 12px 12px}
  :root[data-density=compact] .canteen-card .favorite-toggle{width:44px;height:44px}
  @media(max-width:700px){.canteen-card .canteen-photo-caption{padding-left:15px}.canteen-card .card-body{padding:10px 15px 13px}}
</style>
