---
import '../meals/stars.css';
---
<section class="settings-group starred-meals-settings" aria-labelledby="saved-meals-title">
  <h2 id="saved-meals-title" data-meal-copy="savedTitle">Starred meals</h2>
  <p data-meal-copy="savedHint">When these dishes return to the menu, we’ll bring them to the top. Saved on this device.</p>
  <p class="starred-meals-empty" data-starred-meals-empty data-meal-copy="empty">No starred meals yet. Tap the star next to a dish to save it.</p>
  <ul class="saved-meals-list" data-saved-meals-list></ul>
</section>
