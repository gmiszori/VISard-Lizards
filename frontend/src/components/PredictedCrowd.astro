---
import '../crowd/predicted-crowd.css';
import type { CrowdPrediction } from '../crowd/prediction';
interface Props { prediction: CrowdPrediction }
const { prediction } = Astro.props;
---
<section class="predicted-crowd" data-crowd-chart data-mensa-id={prediction.mensaId} aria-labelledby="predicted-crowd-title">
  <div class="crowd-heading">
    <div><span class="crowd-eyebrow" data-crowd-text="eyebrow">PLAN YOUR LUNCH</span><h2 id="predicted-crowd-title" data-crowd-text="title">Predicted crowd</h2></div>
    <span class="crowd-interval">15 <span data-crowd-text="minutes">min</span></span>
  </div>
  <div class="crowd-toolbar">
    <p data-crowd-text="subtitle">Typical occupancy, every 15 minutes.</p>
    <label class="crowd-day-control"><span class="visually-hidden" data-crowd-text="day">Day</span><select data-crowd-day aria-label="Day"></select></label>
  </div>
  <div data-crowd-content hidden>
    <div class="crowd-plot">
      <svg class="crowd-bars" viewBox="0 0 600 60" preserveAspectRatio="none" role="img" data-crowd-svg aria-label="Predicted occupancy by time">
        <g class="crowd-grid" aria-hidden="true"><line x1="0" x2="600" y1="59" y2="59"/></g>
        <g data-crowd-bars></g>
        <line class="crowd-now-line" data-crowd-now y1="0" y2="60" style="display:none" />
      </svg>
      <div class="crowd-x-axis" data-crowd-ticks aria-hidden="true"></div>
    </div>
    <div class="crowd-legend"><span><i class="crowd-quiet"></i><span data-crowd-text="quiet">Quiet</span></span><span><i class="crowd-moderate"></i><span data-crowd-text="moderate">Moderate</span></span><span><i class="crowd-busy"></i><span data-crowd-text="busy">Busy</span></span><span data-crowd-now-legend hidden><i class="crowd-now-key"></i><span data-crowd-text="now">Now</span></span></div>
  </div>
  <p class="crowd-empty" data-crowd-empty hidden data-crowd-text="empty">No prediction available for this day.</p>
  <p class="crowd-source" data-crowd-source></p>
  <noscript><p class="crowd-empty">Enable JavaScript to explore predicted crowd.</p></noscript>
  <script type="application/json" data-crowd-data is:inline set:html={JSON.stringify(prediction).replace(/</g, '\\u003c')} />
</section>
<script>
  import '../crowd/chart';
</script>
