---
/**
 * Pick the menu day (links to the day pages /day/<date> or /canteen/<id>/<date>) and show all meals,
 * only lunch or only dinner (client-side, remembered on the device).
 * With a simulated time in the developer tools, the default pages jump to that time's menu day.
 */
import { formatMenuDay } from '../data/presentation';
interface Props {
  days: string[];
  /** The day shown on this page. */
  menuDate: string;
  /** true on a day page (the visitor picked the day). */
  chosenDay: boolean;
  /** Set on a canteen page: day links stay on this canteen. */
  canteenId?: string;
}
const { days, menuDate, chosenDay, canteenId } = Astro.props;
const href = (day: string) => (canteenId ? `/canteen/${encodeURIComponent(canteenId)}/${day}` : `/day/${day}`);
const label = (day: string) => formatMenuDay(day);
const shownDays = days.includes(menuDate) ? days : [...days, menuDate].sort();
---
<div class="day-picker" data-day-picker data-picker-date={menuDate} data-chosen-day={String(chosenDay)}
  data-days={JSON.stringify(days)} data-href-base={canteenId ? `/canteen/${encodeURIComponent(canteenId)}/` : '/day/'}>
  <nav class="day-picker-days" aria-label="Menu day" data-day-picker-nav>
    {shownDays.map(day => (
      <a href={href(day)} data-day={day} aria-current={day === menuDate ? 'date' : undefined} class={day === menuDate ? 'is-selected' : undefined}>{label(day)}</a>
    ))}
  </nav>
  <div class="day-picker-services" role="group" aria-label="Meal service" data-service-filter-group>
    <button type="button" data-service-choice="" aria-pressed="true" data-i18n="allMeals">All</button>
    <button type="button" data-service-choice="lunch" aria-pressed="false" data-i18n="lunch">Lunch</button>
    <button type="button" data-service-choice="dinner" aria-pressed="false" data-i18n="dinner">Dinner</button>
  </div>
</div>
<p class="price-category-note"><span data-price-category>Student prices</span> · <a href="/settings" data-i18n="changePriceCategory">Change</a></p>
<script is:inline>
  // Switching the day loads another page. Keep the picker where it was on screen instead of jumping to the
  // top: runs while the page is still loading, right after the picker exists (the click saved its position).
  (() => {
    try {
      const raw = sessionStorage.getItem('campuseats-day-scroll');
      if (!raw) return;
      sessionStorage.removeItem('campuseats-day-scroll');
      const saved = JSON.parse(raw);
      const path = location.pathname.replace(/\/+$/, '');
      if (saved.path !== path || !(Date.now() - saved.at < 10000)) return;
      const picker = document.currentScript.previousElementSibling;
      const body = document.body;
      const place = () => window.scrollTo(0, picker.getBoundingClientRect().top + window.scrollY - saved.top);
      // The rest of the page is not loaded yet: make room so the scroll position can be reached now.
      body.style.minHeight = `${picker.getBoundingClientRect().top + window.scrollY + window.innerHeight * 2}px`;
      place();
      let moved = false;
      const stop = () => { moved = true; };
      for (const type of ['wheel', 'touchstart', 'keydown']) addEventListener(type, stop, { once: true, passive: true });
      const settle = () => { if (!moved) place(); };
      addEventListener('DOMContentLoaded', () => { body.style.minHeight = ''; settle(); });
      addEventListener('load', settle);
      setTimeout(settle, 400);
    } catch { /* storage blocked: the page simply starts at the top */ }
  })();
</script>
<script>
  import { activeSimulatedClock, appNow, CLOCK_EVENT, zurichParts } from '../time/clock';
  import { defaultService, wantedMenuDate } from '../data/menuDate';
  import { formatMenuDay } from '../data/presentation';

  const SERVICE_KEY = 'campuseats-service-filter';
  const root = document.querySelector<HTMLElement>('[data-day-picker]');
  const daysNav = root?.querySelector<HTMLElement>('[data-day-picker-nav]');
  const updateScrollHint = () => daysNav?.classList.toggle('has-more-days',
    daysNav.scrollWidth - daysNav.clientWidth - daysNav.scrollLeft > 2);
  daysNav?.addEventListener('scroll', updateScrollHint, { passive: true });
  window.addEventListener('resize', updateScrollHint);

  // Lunch / dinner filter: an attribute on <html>; scripts/preferences.ts hides the other service's meals.
  function applyService(service: string) {
    if (service) document.documentElement.dataset.serviceFilter = service;
    else delete document.documentElement.dataset.serviceFilter;
    root?.querySelectorAll<HTMLButtonElement>('[data-service-choice]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.serviceChoice === service)));
    document.dispatchEvent(new Event('campuseats:service-filter-changed'));
  }
  // Not just the clock: Saturday night the page shows Monday's menu, which opens on Monday's lunch.
  const serviceByTime = () => { const now = zurichParts(appNow()); return defaultService(root?.dataset.pickerDate ?? now.date, now.date, now.time); };
  let saved: string | null = null;
  try { saved = localStorage.getItem(SERVICE_KEY); } catch { /* storage blocked */ }
  const initialService = saved === null ? serviceByTime() : saved === 'lunch' || saved === 'dinner' || saved === '' ? saved : serviceByTime();
  applyService(initialService);
  root?.querySelectorAll<HTMLButtonElement>('[data-service-choice]').forEach(button => button.addEventListener('click', () => {
    const service = button.dataset.serviceChoice ?? '';
    try { localStorage.setItem(SERVICE_KEY, service); } catch { /* storage blocked */ }
    applyService(service);
  }));

  // Day labels in the page language, "Today" for today.
  function renderDays() {
    if (!root) return;
    const de = document.documentElement.lang === 'de';
    root.querySelectorAll<HTMLAnchorElement>('[data-day]').forEach(link => {
      const day = link.dataset.day!;
      link.textContent = formatMenuDay(day, de ? 'de' : 'en');
    });
    root.querySelector('[data-day-picker-nav]')?.setAttribute('aria-label', de ? 'Menütag' : 'Menu day');
    root.querySelector('[data-service-filter-group]')?.setAttribute('aria-label', de ? 'Mahlzeit' : 'Meal service');
    updateScrollHint();
  }

  // Simulated time (developer tools): the default pages follow its menu day.
  function followSimulatedDay() {
    if (!root || root.dataset.chosenDay === 'true' || !activeSimulatedClock()) return;
    const wanted = wantedMenuDate(zurichParts(appNow()).date);
    const days = JSON.parse(root.dataset.days ?? '[]') as string[];
    if (wanted !== root.dataset.pickerDate && days.includes(wanted)) location.replace(`${root.dataset.hrefBase}${wanted}`);
  }

  // Remember where the picker is on screen; the next day's page restores it (inline script above).
  root?.querySelectorAll<HTMLAnchorElement>('[data-day]').forEach(link => link.addEventListener('click', () => {
    try {
      sessionStorage.setItem('campuseats-day-scroll', JSON.stringify({
        path: new URL(link.href).pathname.replace(/\/+$/, ''), top: root.getBoundingClientRect().top, at: Date.now(),
      }));
    } catch { /* storage blocked */ }
  }));

  // On a day the visitor picked that is not today, live status ("Closed" right now), the current crowd and today's hours say nothing
  // about that day: hide them (CSS: [data-other-day] in styles/global.css).
  function markOtherDay() {
    if (!root) return;
    const other = root.dataset.chosenDay === 'true' && root.dataset.pickerDate !== zurichParts(appNow()).date;
    document.documentElement.toggleAttribute('data-other-day', other);
  }

  renderDays();
  markOtherDay();
  followSimulatedDay();
  document.addEventListener('languagechange', renderDays);
  document.addEventListener(CLOCK_EVENT, () => { renderDays(); markOtherDay(); followSimulatedDay(); });
</script>
<style>.price-category-note{margin:0 0 16px;color:var(--muted);font-size:12px}.price-category-note a{display:inline-flex;align-items:center;min-width:44px;min-height:44px;margin-block:-13px;vertical-align:middle;color:var(--green);text-decoration:underline;text-underline-offset:3px}</style>
<style>
  .day-picker{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 16px;margin:0 0 14px}
  .day-picker-days,.day-picker-services{display:flex;flex-wrap:wrap;gap:6px}
  .day-picker a,.day-picker button{display:inline-flex;align-items:center;min-height:44px;padding:6px 12px;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--ink);font:700 13px 'DM Sans',sans-serif;text-decoration:none;cursor:pointer;white-space:nowrap}
  .day-picker a:hover,.day-picker button:hover{border-color:var(--green)}
  .day-picker a.is-selected,.day-picker button[aria-pressed="true"]{background:var(--green);border-color:var(--green);color:var(--paper)}
  .day-picker a:focus-visible,.day-picker button:focus-visible{outline:3px solid color-mix(in srgb,var(--green) 45%,transparent);outline-offset:2px}
  /* Page changes (day, canteen) cross-fade instead of flashing white, where the browser supports it. */
  @media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }
  @media(max-width:520px){.day-picker{gap:8px}.day-picker-days{flex-wrap:nowrap;overflow-x:auto;width:100%;min-width:0;padding-bottom:2px}.day-picker-days.has-more-days{mask-image:linear-gradient(to right,#000 calc(100% - 28px),transparent);-webkit-mask-image:linear-gradient(to right,#000 calc(100% - 28px),transparent)}}
</style>
