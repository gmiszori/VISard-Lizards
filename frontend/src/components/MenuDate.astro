---
/**
 * Says which day a menu is for. On days without meals (weekends) the pages show the next day's menu,
 * so "today" would be wrong there; the date is formatted in the page language.
 */
interface Props {
  /** The menu's day, YYYY-MM-DD. */
  date: string;
  /** Today in Zurich, YYYY-MM-DD. */
  today: string;
  /** heading: "Today's menu" / "Menu for …" (detail page); note: "Menus for …", hidden when today (home). */
  variant: 'heading' | 'note';
}
const { date, today, variant } = Astro.props;
const label = new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' })
  .format(new Date(`${date}T00:00:00Z`));
---
{date === today
  ? variant === 'heading' && <span data-i18n="todayMenu">Today’s menu</span>
  : <span class={variant === 'note' ? 'menu-date-note' : undefined}><span data-i18n={variant === 'note' ? 'menusFor' : 'menuFor'}>{variant === 'note' ? 'Menus for' : 'Menu for'}</span> <time datetime={date} data-menu-date={date}>{label}</time></span>}
<script>
  const format = () => {
    const lang = document.documentElement.lang === 'de' ? 'de-CH' : 'en-GB';
    document.querySelectorAll<HTMLElement>('[data-menu-date]').forEach((el) => {
      el.textContent = new Intl.DateTimeFormat(lang, { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' })
        .format(new Date(`${el.dataset.menuDate}T00:00:00Z`));
    });
  };
  document.addEventListener('languagechange', format);
  format();
</script>
<style>
  .menu-date-note { display: block; margin: 0 0 12px; font-weight: 600; }
</style>
