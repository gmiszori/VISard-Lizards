---
import { type DisplayMenuItem } from '../data/menu-display';
import MealPrice from './MealPrice.astro';
import MealStar from './MealStar.astro';
import MealServingTime from './MealServingTime.astro';
import { allergenIds, allergenLabel } from '../allergens/allergens';
interface Props { item: DisplayMenuItem }
const { item } = Astro.props;
const ids = allergenIds(item.allergens ?? []);
---
<article class="menu-item" data-diet={item.dietary} data-allergens={ids.join(' ')} data-meal-row data-meal-id={item.id}>
  <span class="eyebrow" data-i18n={`category_${item.category.toLowerCase().replace(' ', '_')}`}>{item.category}</span>
  <div class="meal-detail-heading"><h3>{item.name}</h3><MealStar item={item} /></div>
  <MealServingTime item={item} />
  <p>{item.description}</p>
  <p style="margin-top:9px" data-allergen-line><span data-i18n={ids.length ? 'contains' : 'noAllergens'}>{ids.length ? 'Contains' : 'No listed allergens'}</span>{ids.length > 0 && <>: <span class="allergen-names" lang="en">{ids.map((id) => allergenLabel(id, 'en')).join(', ')}</span><span class="allergen-names" lang="de">{ids.map((id) => allergenLabel(id, 'de')).join(', ')}</span></>}{ids.length === 0 && <span class="allergen-unknown" data-allergen-unknown hidden data-i18n="allergenUnknown"> · check with the staff</span>}</p>
  <div class={`menu-diet diet-${item.dietary}`} data-i18n={`diet_${item.dietary}`}>{item.dietary}</div>
  <MealPrice item={item} />
</article>
