---
import { CAMPUSES } from '../data/canteens';
import NearMe from '../location/NearMe.astro';
---
<div class="toolbar">
  <label class="search"><svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg><input type="search" id="search-input" maxlength="200" data-i18n-placeholder="search" data-i18n-aria="search" placeholder="Search canteens or dishes" aria-label="Search canteens or dishes" /></label>
  <div class="campus-tools">
    <select id="campus-select" class="campus-select" data-i18n-aria="campusSelect" aria-label="Campus">
      <option value="preset" data-i18n="campusPreset">My campuses</option>
      <option value="all" data-i18n="campusAll">All campuses</option>
      {CAMPUSES.map((campus) => <option value={campus.id}>{campus.name}</option>)}
    </select>
    <NearMe />
  </div>
</div>
<p id="search-status" class="search-status" role="status" aria-live="polite" hidden></p>
<style>
  .search-status{margin:-8px 0 14px;color:var(--muted);font-size:12px}
  .toolbar{display:flex;gap:8px;align-items:center}
  .toolbar :global(.search){flex:1 1 auto;min-width:0;margin:0}
  .toolbar :global(.search input){height:40px;font-size:14px}
  .toolbar :global(.search-icon){top:50%;left:13px;width:18px;height:18px;transform:translateY(-50%);pointer-events:none}
  .campus-tools{display:flex;align-items:center;gap:8px;min-width:0;flex:0 0 auto}
  .campus-select{height:40px;min-height:40px;flex:0 1 auto;max-width:48%;padding:0 12px;border:1px solid var(--line);border-radius:14px;background:var(--paper);color:var(--ink);font:inherit;font-size:14px}
  .campus-tools :global(.near-me){margin:0;flex:0 0 auto}
  .campus-select:focus-visible{outline:2px solid var(--green);outline-offset:2px}
  @media(max-width:700px){
    .toolbar{flex-wrap:wrap}
    .toolbar :global(.search){flex:1 1 220px;display:block;margin:0}
    .toolbar :global(.search input){height:44px;font-size:16px}
    .campus-tools{flex:0 1 auto}
    .campus-select{height:44px;min-height:44px;font-size:14px;max-width:none}
  }
  /* Keep the campus selector and distance sort together even on narrow phones. */
  @media(max-width:400px){
    .toolbar :global(.search){flex:1 1 100%}
    .campus-tools{flex:1 1 100%}
    .campus-select{flex:1 1 auto;max-width:none}
    /* A long label ("Nach Entfernung sortieren") wraps inside the button instead of widening the page. */
    .campus-tools :global(.near-me){flex:0 1 auto;min-width:0}
    .campus-tools :global(.near-me-toggle){white-space:normal;line-height:1.2;padding-block:6px;text-align:center}
  }
</style>
