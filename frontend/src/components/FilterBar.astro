---
import { CAMPUSES } from '../data/canteens';
---
<div class="toolbar">
  <label class="search"><span class="search-icon" aria-hidden="true">⌕</span><input type="search" id="search-input" data-i18n-placeholder="search" data-i18n-aria="search" placeholder="Search canteens or dishes" aria-label="Search canteens or dishes" /></label>
  <select id="campus-select" class="campus-select" data-i18n-aria="campusSelect" aria-label="Campus">
    <option value="preset" data-i18n="campusPreset">My campuses</option>
    <option value="all" data-i18n="campusAll">All campuses</option>
    {CAMPUSES.map((campus) => <option value={campus.id}>{campus.name}</option>)}
  </select>
  <button type="button" id="near-me" class="near-me" aria-pressed="false">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
    <span data-near-label>Near me</span>
  </button>
  <p id="near-me-status" class="near-me-status" role="status" hidden></p>
</div>
<script>import '../scripts/near-me';</script>
<style>
  .toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .toolbar :global(.search){flex:1 1 150px;max-width:240px;min-width:0;margin:0}
  .toolbar :global(.search input){height:40px;font-size:14px}
  .toolbar :global(.search-icon){top:10px}
  .campus-select,.near-me{height:40px;min-height:40px;padding:0 12px;border:1px solid var(--line);border-radius:14px;background:var(--paper);color:var(--ink);font:inherit;font-size:14px}
  .campus-select{flex:0 1 auto;max-width:48%}
  .near-me{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;cursor:pointer}
  .near-me[aria-pressed="true"]{background:var(--green);border-color:var(--green);color:#fff}
  .near-me:disabled{opacity:.6;cursor:progress}
  .campus-select:focus-visible,.near-me:focus-visible{outline:2px solid var(--green);outline-offset:2px}
  .near-me-status{flex:1 1 100%;margin:0;font-size:13px;color:var(--muted)}
  @media(max-width:700px){
    .toolbar :global(.search){flex:1 1 140px;max-width:none;display:block;margin:0}
    .toolbar :global(.search input){height:44px;font-size:16px}
    .toolbar :global(.search-icon){top:12px}
    .campus-select,.near-me{height:44px;min-height:44px}
    .campus-select{max-width:46%}
  }
</style>
