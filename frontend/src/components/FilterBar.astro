---
import { CAMPUSES } from '../data/canteens';
import NearMe from '../location/NearMe.astro';
---
<div class="toolbar">
  <label class="search"><svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg><input type="search" id="search-input" maxlength="200" data-i18n-placeholder="search" data-i18n-aria="search" placeholder="Search canteens or dishes" aria-label="Search canteens or dishes" /></label>
  <button type="button" id="voice-search-button" class="voice-search-button" data-i18n-aria="voiceSearch" data-i18n-title="voiceSearch" aria-label="Search by voice" title="Search by voice" aria-pressed="false"><svg class="voice-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5.5 11.5v1a6.5 6.5 0 0 0 13 0v-1M12 19v3m-4 0h8"/></svg></button>
  <div class="campus-tools">
    <select id="campus-select" class="campus-select" data-i18n-aria="campusSelect" aria-label="Campus">
      <option value="preset" data-i18n="campusPreset">My campuses</option>
      <option value="all" data-i18n="campusAll">All campuses</option>
      {CAMPUSES.map((campus) => <option value={campus.id}>{campus.name}</option>)}
    </select>
    <NearMe />
  </div>
</div>
<p id="search-status" class="search-status" role="status" aria-live="polite" hidden></p>
<p id="voice-agent-caption" class="voice-agent-caption" aria-live="polite" hidden></p>
<section id="ai-results" class="ai-results" aria-labelledby="ai-results-title" hidden>
  <div class="ai-results-heading"><h2 id="ai-results-title" data-i18n="aiMatches">AI-ranked dish matches</h2><span id="ai-results-count"></span></div>
  <p id="ai-results-intent" class="ai-results-intent"></p>
  <p class="ai-results-explainer" data-i18n="aiMatchesHint">These are specific dish matches ranked by relevance. The canteen menus below remain your regular menu previews.</p>
  <div id="ai-results-list" class="ai-results-list"></div>
</section>
<style>
  .search-status{margin:-8px 0 14px;color:var(--muted);font-size:12px}
  .voice-agent-caption{margin:-8px 0 14px;padding:10px 12px;border-radius:12px;background:var(--paper);color:var(--ink);font-size:13px;line-height:1.5;white-space:pre-wrap}
  .ai-results{margin:0 0 18px;padding:16px;border:1px solid var(--line);border-radius:16px;background:var(--paper)}
  .ai-results-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
  .ai-results-heading h2{margin:0;font-size:17px}
  .ai-results-heading span{color:var(--muted);font-size:13px}
  .ai-results-intent{margin:6px 0 12px;color:var(--muted);font-size:13px}
  .ai-results-explainer{margin:-4px 0 12px;color:var(--muted);font-size:12px;line-height:1.45}
  .ai-results-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
  .ai-results-list :global(.ai-result){display:block;padding:12px;border:1px solid var(--line);border-radius:12px;color:var(--ink);text-decoration:none}
  .ai-results-list :global(.ai-result:hover){border-color:var(--green)}
  .ai-results-list :global(.ai-result strong){display:block;margin-bottom:4px}
  .ai-results-list :global(.ai-result span){display:block;color:var(--muted);font-size:12px}
  .toolbar{display:flex;gap:8px;align-items:center}
  .toolbar :global(.search){flex:1 1 auto;min-width:0;margin:0}
  .toolbar :global(.search input){height:46px;font-size:14px}
  .toolbar :global(.search-icon){top:50%;left:13px;width:18px;height:18px;transform:translateY(-50%);pointer-events:none}
  .voice-search-button{display:grid;place-items:center;width:48px;height:48px;flex:0 0 48px;padding:0;border:0;border-radius:15px;background:#ef8b3a;color:#fff;cursor:pointer;box-shadow:0 4px 12px #a64c162a;transition:background .16s,transform .16s,box-shadow .16s}
  .voice-search-button:hover:not(:disabled){background:#dc7626;transform:translateY(-1px);box-shadow:0 6px 16px #a64c1638}
  .voice-icon{width:25px;height:25px;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .voice-search-button[aria-pressed="true"]{background:#b83838;border-color:#b83838;color:white;animation:voice-pulse 1.1s ease-in-out infinite alternate}
  .voice-search-button:disabled{opacity:.45;cursor:not-allowed}
  .voice-search-button:focus-visible{outline:3px solid #7eb594;outline-offset:2px}
  @keyframes voice-pulse{to{box-shadow:0 0 0 5px #b8383825}}
  .campus-tools{display:flex;align-items:center;gap:8px;min-width:0;flex:0 0 auto}
  .campus-select{height:40px;min-height:40px;flex:0 1 auto;max-width:48%;padding:0 12px;border:1px solid var(--line);border-radius:14px;background:var(--paper);color:var(--ink);font:inherit;font-size:14px}
  .campus-tools :global(.near-me){margin:0;flex:0 0 auto}
  .campus-select:focus-visible{outline:2px solid var(--green);outline-offset:2px}
  @media(max-width:700px){
    .toolbar{flex-wrap:wrap}
    .toolbar :global(.search){flex:1 1 200px;display:block;margin:0}
    .toolbar :global(.search input){height:44px;font-size:16px}
    .campus-tools{flex:0 1 auto}
    .campus-select{height:44px;min-height:44px;font-size:14px;max-width:none}
  }
  @media(max-width:1024px) and (orientation:portrait){
    .voice-search-button{position:fixed;z-index:70;right:calc(18px + env(safe-area-inset-right, 0px));bottom:calc(20px + env(safe-area-inset-bottom, 0px));width:60px;height:60px;flex-basis:60px;border-radius:50%}
    .voice-icon{width:28px;height:28px}
  }
  /* Keep the campus selector and distance sort together even on narrow phones. */
  @media(max-width:400px){
    .toolbar :global(.search){flex:1 1 100%}
    .campus-tools{flex:1 1 100%}
    .campus-select{flex:1 1 auto;max-width:none}
    /* A long label ("Nach Entfernung sortieren") wraps inside the button instead of widening the page. */
    .campus-tools :global(.near-me){flex:0 1 auto;min-width:0}
    .campus-tools :global(.near-me-toggle){white-space:normal;line-height:1.2;padding-block:6px;text-align:center}
  }
</style>
