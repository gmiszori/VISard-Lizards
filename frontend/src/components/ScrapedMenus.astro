<section class="scraped-menus" aria-labelledby="scraped-title">
  <div class="section-head"><div><h2 id="scraped-title">Live menus from cafeteria websites</h2><p>Meals, catering offers and published closures. Refreshed daily at 06:00 Zurich time.</p></div></div>
  <p data-scraped-status role="status">Loading saved menus…</p>
  <div data-scraped-list></div>
</section>
<script>
  import { apiGet } from '../data/api';
  type RecordValue = Record<string, any>;
  const status = document.querySelector<HTMLElement>('[data-scraped-status]');
  const list = document.querySelector<HTMLElement>('[data-scraped-list]');
  function node(tag: string, text: string): HTMLElement {
    const el = document.createElement(tag); el.textContent = text; return el;
  }
  function sourceLink(url: unknown): HTMLElement | null {
    if (typeof url !== 'string') return null;
    try { if (new URL(url).protocol !== 'https:') return null; } catch { return null; }
    const link = document.createElement('a'); link.href = url; link.textContent = 'View source';
    link.target = '_blank'; link.rel = 'noopener noreferrer'; return link;
  }
  async function refresh() {
    if (!list || !status) return;
    try {
      const data = await apiGet<RecordValue>('/api/scraped-menus', undefined, 10000);
      if (!Array.isArray(data.cafeterias)) throw new Error('Invalid menus');
      status.textContent = !data.configured ? (data.lastCompleted ? 'Showing saved results. Configure the backend OpenAI key to enable automatic refreshes.' : 'Live website menus have not been enabled yet.') : !data.enabled ? 'Showing saved results. Automatic refreshes are disabled.' : data.running ?
        'Menus are refreshing in the background. Showing the latest saved results.' :
        data.lastCompleted ? `Last refresh: ${new Date(data.lastCompleted).toLocaleString()}` : 'Waiting for the first refresh.';
      const today = new Intl.DateTimeFormat('en-CA', {timeZone:'Europe/Zurich', year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
      const expanded = new Set(Array.from(list.querySelectorAll<HTMLDetailsElement>('details.scraped-venue[open]')).map(card => card.dataset.venue));
      list.replaceChildren();
      for (const venue of data.cafeterias) {
        const card = document.createElement('details'); card.className = 'scraped-venue';
        card.dataset.venue = venue.id; card.open = expanded.has(venue.id);
        const results = Array.isArray(venue.result?.toolResults) ? venue.result.toolResults : [];
        const meals = new Map<string, RecordValue>(); const closures = new Map<string, RecordValue>(); const warnings = new Set<string>();
        for (const result of results) {
          const raw = result.data ?? {};
          if (result.name === 'scrape_meals') for (const meal of raw.meals ?? []) {
            if (!meal.date || meal.date >= today) meals.set(meal.id ?? JSON.stringify([meal.name, meal.date, meal.sourceUrl]), meal);
          }
          for (const closure of raw.availability ?? []) if (!closure.dateTo || closure.dateTo >= today) closures.set(JSON.stringify(closure), closure);
          for (const warning of raw.warnings ?? []) if (typeof warning === 'string') warnings.add(warning);
        }
        card.append(node('summary', `${venue.name} · ${meals.size} entries${closures.size ? ' · Closure published' : ''}${venue.status === 'source_unavailable' ? ' · Source unavailable' : venue.stale ? ' · Refresh failed' : ''}`));
        if (venue.updatedAt) card.append(node('p', `Updated: ${new Date(venue.updatedAt).toLocaleString()}`));
        if (venue.status === 'source_unavailable') card.append(node('p', 'A public meal source is not available for this cafeteria yet.'));
        else if (venue.error) card.append(node('p', venue.result ? 'Showing previous results because the latest refresh failed.' : 'No live results yet; the latest refresh failed.'));
        if (venue.status === 'pending') card.append(node('p', 'Waiting for the scheduled refresh.'));
        for (const closure of closures.values()) {
          card.append(node('p', `Closed: ${closure.dateFrom ?? 'start unknown'} – ${closure.dateTo ?? 'until further notice'}. ${closure.evidence}`));
          const link = sourceLink(closure.sourceUrl); if (link) card.append(link);
        }
        if (venue.result?.explanation) card.append(node('p', venue.result.explanation));
        for (const meal of meals.values()) {
          const entry = document.createElement('article'); entry.className = 'scraped-dish';
          entry.append(node('h3', meal.name ?? 'Unnamed entry'));
          entry.append(node('p', `${meal.date ?? 'Undated offer · availability unknown'}${meal.timeStart ? ` · ${meal.timeStart}–${meal.timeEnd ?? '?'}` : ''}`));
          if (meal.description) entry.append(node('p', meal.description));
          const prices = meal.prices?.length ? meal.prices : meal.price ? [meal.price] : [];
          entry.append(node('p', prices.length ? prices.map((price: RecordValue) => `${price.customerGroup ?? 'Price'}: ${price.currency} ${price.amount}`).join(' · ') : 'Price unknown'));
          if (meal.dietaryLabels?.length) entry.append(node('p', meal.dietaryLabels.join(' · ')));
          if (meal.allergens?.length) entry.append(node('p', `Allergens: ${meal.allergens.join(', ')}`));
          const link = sourceLink(meal.sourceUrl); if (link) entry.append(link);
          card.append(entry);
        }
        for (const warning of warnings) card.append(node('p', warning));
        if (venue.result) {
          const raw = document.createElement('details'); raw.append(node('summary', 'Full source results'));
          raw.append(node('pre', JSON.stringify(venue.result, null, 2))); card.append(raw);
        }
        list.append(card);
      }
    } catch { status.textContent = 'Live website menus are currently unavailable.'; }
  }
  void refresh();
  // Poll saved results only. This endpoint never starts an AI request.
  window.setInterval(() => { if (!document.hidden) void refresh(); }, 60000);
</script>
<style is:global>
  .scraped-menus { margin-top: 2rem; }
  .scraped-menus .scraped-venue { border: 1px solid var(--border, #d9dfd3); border-radius: 12px; padding: 1rem; margin-bottom: .75rem; }
  .scraped-menus .scraped-venue > summary { cursor: pointer; font-weight: 600; padding: .5rem 0; }
  .scraped-menus .scraped-dish { padding: .75rem 0; border-top: 1px solid var(--border, #d9dfd3); }
  .scraped-menus pre { overflow: auto; max-height: 25rem; font-size: .8rem; white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
