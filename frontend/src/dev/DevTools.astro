---
import { API_URL } from '../data/api';
import { CAMPUSES, MENSAS } from '../data/canteens';
import type { AppCanteen } from '../data/app-data';

interface Props {
  canteens: AppCanteen[];
  source: 'backend' | 'sample';
  sampleReason?: 'unreachable' | 'invalid';
  menuDate: string;
  today: string;
}

const { canteens, source, sampleReason, menuDate, today } = Astro.props;
const canteenState = Object.fromEntries(canteens.map((canteen) => [canteen.id, {
  menuCount: canteen.menu.length,
  rating: canteen.rating,
  initialOpen: canteen.isOpen,
  occupancy: canteen.occupancy,
}]));
const devData = {
  apiUrl: API_URL,
  source,
  sampleReason: sampleReason ?? null,
  menuDate,
  today,
  campuses: Object.fromEntries(CAMPUSES.map((campus) => [campus.id, campus.name])),
  mensas: MENSAS.map((mensa) => ({
    id: mensa.id,
    name: mensa.name,
    institution: mensa.institution,
    campusId: mensa.campusId,
    hasMenu: mensa.hasMenu,
    temporarilyClosed: mensa.temporarilyClosed,
    coordinates: mensa.coordinates ? { lat: mensa.coordinates.lat, lng: mensa.coordinates.lng, source: mensa.coordinates.source } : null,
    openingHours: mensa.openingHours,
    closures: mensa.closures,
    source: mensa.source,
    state: canteenState[mensa.id] ?? null,
  })),
};
---
<section class="dev-tools" data-dev-tools hidden aria-labelledby="dev-tools-title">
  <div class="dev-tools-head">
    <div>
      <span class="eyebrow">Developer tools</span>
      <h2 id="dev-tools-title">Runtime status</h2>
    </div>
    <div class="dev-actions">
      <button type="button" data-dev-refresh>Refresh</button>
      <button type="button" data-dev-locate>Read position</button>
      <button type="button" data-dev-clear-visits>Clear visits</button>
      <button type="button" data-dev-collapse aria-expanded="true" aria-controls="dev-tools-body">Collapse</button>
    </div>
  </div>
  <div class="dev-tools-body" id="dev-tools-body" data-dev-tools-body>
  <div class="dev-summary" data-dev-summary></div>
  <div class="dev-grid">
    <section class="dev-panel" aria-labelledby="dev-backend-title">
      <h3 id="dev-backend-title">Data and backend</h3>
      <dl data-dev-backend></dl>
    </section>
    <section class="dev-panel" aria-labelledby="dev-position-title">
      <h3 id="dev-position-title">Position</h3>
      <dl data-dev-position></dl>
      <ol class="dev-nearest" data-dev-nearest></ol>
    </section>
  </div>
  <section class="dev-panel" aria-labelledby="dev-live-title">
    <h3 id="dev-live-title">Mensa live accessibility</h3>
    <div class="dev-table-wrap">
      <table class="dev-table">
        <thead><tr><th>Mensa</th><th>Campus</th><th>Now</th><th>Window</th><th>Menu</th><th>Configured source</th><th>Distance</th></tr></thead>
        <tbody data-dev-live-table></tbody>
      </table>
    </div>
  </section>
  <section class="dev-panel dev-clock" data-dev-clock aria-labelledby="dev-clock-title">
    <h3 id="dev-clock-title">Simulated time</h3>
    <p class="dev-hint">Set the app's date and time (Zurich) to test weekdays and service hours, e.g. on a weekend. Affects the menu day, open/closed, opening hours, the crowd chart and survey and the rating prompt. Only while Dev mode is on; a banner shows it on every page.</p>
    <p class="dev-clock-current" data-dev-clock-current></p>
    <div class="dev-clock-form">
      <label for="dev-clock-date">Date<input id="dev-clock-date" type="date" data-dev-clock-date /></label>
      <label for="dev-clock-time">Time<input id="dev-clock-time" type="time" step="60" data-dev-clock-time /></label>
      <label class="dev-clock-running"><input type="checkbox" data-dev-clock-running checked /> Keep running</label>
    </div>
    <div class="dev-actions dev-clock-actions">
      <button type="button" data-dev-clock-apply>Set time</button>
      <button type="button" data-dev-clock-preset="1 11:45">Mon 11:45</button>
      <button type="button" data-dev-clock-preset="1 12:30">Mon 12:30</button>
      <button type="button" data-dev-clock-preset="1 18:30">Mon 18:30</button>
      <button type="button" data-dev-clock-preset="3 13:00">Wed 13:00</button>
      <button type="button" data-dev-clock-preset="5 21:00">Fri 21:00</button>
      <button type="button" data-dev-clock-plus-hour>+1 hour</button>
      <button type="button" data-dev-clock-reset>Use real time</button>
    </div>
    <p class="dev-crowd-status" data-dev-clock-status role="status" aria-live="polite"></p>
  </section>
  <section class="dev-panel dev-crowd-mock" data-dev-crowd-mock aria-labelledby="dev-crowd-title">
    <h3 id="dev-crowd-title">Crowd survey mock</h3>
    <p class="dev-hint">Test "How busy is it right now?" without the backend. While the mock is on, canteen pages on this device read and write these reports instead of the backend, and the survey card says "Mock data".</p>
    <div class="dev-crowd-toggles">
      <label><input type="checkbox" id="dev-crowd-enabled" data-dev-crowd-enabled /> Use mock crowd data</label>
      <label><input type="checkbox" id="dev-crowd-force-open" data-dev-crowd-force-open /> Show the survey even when the mensa is closed</label>
    </div>
    <div class="dev-crowd-form">
      <label for="dev-crowd-mensa">Mensa<select id="dev-crowd-mensa" data-dev-crowd-mensa>{MENSAS.map((mensa) => <option value={mensa.id}>{mensa.name}</option>)}</select></label>
      <label for="dev-crowd-level">Level<select id="dev-crowd-level" data-dev-crowd-level>
        <option value="1">1 · Empty</option><option value="2">2 · Quiet</option><option value="3">3 · Some queue</option><option value="4" selected>4 · Busy</option><option value="5">5 · Packed</option>
      </select></label>
      <label for="dev-crowd-count">Reports<input id="dev-crowd-count" type="number" min="1" max="50" value="3" data-dev-crowd-count /></label>
    </div>
    <div class="dev-actions dev-crowd-actions">
      <button type="button" data-dev-crowd-add>Add reports</button>
      <button type="button" data-dev-crowd-clear>Clear this mensa</button>
      <button type="button" data-dev-crowd-clear-all>Clear all</button>
      <button type="button" data-dev-crowd-reset-lock>Reset report lock</button>
      <a class="dev-crowd-open" data-dev-crowd-open href="/">Open canteen page →</a>
    </div>
    <p class="dev-crowd-status" data-dev-crowd-status role="status" aria-live="polite"></p>
    <ul class="dev-crowd-list" data-dev-crowd-list></ul>
  </section>
  <section class="dev-panel" aria-labelledby="dev-storage-title">
    <h3 id="dev-storage-title">Device state</h3>
    <div class="dev-storage" data-dev-storage></div>
  </section>
  </div>
</section>
<script type="application/json" data-dev-data is:inline set:html={JSON.stringify(devData).replace(/</g, '\\u003c')} />
<script>
  import { mountDevTools } from '../dev/dev-tools.ts';
  mountDevTools();
</script>
<style>
  .dev-tools{margin:20px 0 28px;padding:18px;border:1px solid color-mix(in srgb,var(--green) 24%,var(--line));border-radius:8px;background:color-mix(in srgb,var(--paper) 86%,var(--green) 6%);box-shadow:var(--shadow)}
  .dev-tools[hidden]{display:none}
  .dev-tools.is-collapsed .dev-tools-head{margin-bottom:0}
  .dev-tools.is-collapsed [data-dev-tools-body],.dev-tools.is-collapsed .dev-actions button:not([data-dev-collapse]){display:none}
  .dev-tools-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:14px}
  .dev-tools h2,.dev-tools h3{font-family:Manrope,sans-serif;margin:0;color:var(--ink)}
  .dev-tools h2{font-size:22px}.dev-tools h3{font-size:14px;margin-bottom:10px}
  .dev-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
  .dev-actions button{min-height:38px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink);font:700 12px 'DM Sans',sans-serif;padding:8px 11px;cursor:pointer}
  .dev-actions button:hover{border-color:var(--green);color:var(--green)}
  .dev-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-bottom:12px}
  .dev-summary span{display:block;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--paper);font-size:12px;line-height:1.35;min-width:0}
  .dev-summary strong{display:block;font-size:17px;color:var(--green);margin-bottom:3px}
  .dev-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
  .dev-panel{min-width:0;padding:14px;border:1px solid var(--line);border-radius:8px;background:var(--paper)}
  .dev-panel dl{display:grid;grid-template-columns:minmax(120px,auto) 1fr;gap:7px 12px;margin:0;font-size:12px}
  .dev-panel dt{color:var(--muted);font-weight:700}.dev-panel dd{margin:0;overflow-wrap:anywhere}
  .dev-nearest{margin:10px 0 0;padding-left:22px;font-size:12px;color:var(--muted);line-height:1.6}
  .dev-table-wrap{overflow:auto;max-height:360px;border:1px solid var(--line);border-radius:8px}
  .dev-table{width:100%;border-collapse:collapse;font-size:12px;min-width:760px}
  .dev-table th,.dev-table td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
  .dev-table th{position:sticky;top:0;background:var(--paper);z-index:1;color:var(--muted);font-size:11px;text-transform:uppercase}
  .dev-live-open{color:var(--green);font-weight:800}.dev-live-closed{color:var(--muted);font-weight:700}
  .dev-storage{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;font-size:12px}
  .dev-storage pre{margin:0;max-height:160px;overflow:auto;padding:10px;border:1px solid var(--line);border-radius:8px;background:color-mix(in srgb,var(--paper) 92%,var(--line));white-space:pre-wrap;overflow-wrap:anywhere}
  .dev-crowd-mock,.dev-clock{margin-bottom:12px}
  .dev-clock-current{margin:0 0 10px;font-size:13px;font-weight:800;color:var(--green)}
  .dev-clock-form{display:flex;flex-wrap:wrap;align-items:flex-end;gap:8px 12px;margin-bottom:10px}
  .dev-clock-form label{display:grid;gap:4px;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase}
  .dev-clock-form input[type=date],.dev-clock-form input[type=time]{min-height:38px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink);font:600 13px 'DM Sans',sans-serif;padding:6px 8px}
  .dev-clock-form .dev-clock-running{display:inline-flex;align-items:center;gap:6px;min-height:38px;text-transform:none;font-size:12px;color:var(--ink)}
  .dev-clock-actions{justify-content:flex-start}
  .dev-hint{margin:0 0 10px;color:var(--muted);font-size:12px;line-height:1.5;max-width:75ch}
  .dev-crowd-toggles{display:flex;flex-wrap:wrap;gap:8px 18px;margin-bottom:10px;font-size:12px;font-weight:700}
  .dev-crowd-toggles label{display:inline-flex;align-items:center;gap:6px;cursor:pointer}
  .dev-crowd-form{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr) minmax(0,90px);gap:8px;margin-bottom:10px}
  .dev-crowd-form label{display:grid;gap:4px;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;min-width:0}
  .dev-crowd-form select,.dev-crowd-form input{min-height:38px;width:100%;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink);font:600 13px 'DM Sans',sans-serif;padding:6px 8px;text-transform:none}
  .dev-crowd-actions{justify-content:flex-start;align-items:center}
  .dev-crowd-open{font-size:12px;font-weight:700;color:var(--green)}
  .dev-crowd-status{margin:8px 0 0;font-size:12px;color:var(--green);font-weight:700}.dev-crowd-status:empty{display:none}
  .dev-crowd-list{margin:8px 0 0;padding-left:20px;font-size:12px;line-height:1.6;color:var(--muted)}
  @media(max-width:760px){.dev-crowd-form{grid-template-columns:1fr 1fr}.dev-crowd-form label:first-child{grid-column:1/-1}}
  @media(max-width:760px){.dev-tools-head,.dev-grid{display:block}.dev-actions{justify-content:flex-start;margin-top:10px}.dev-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.dev-panel{margin-bottom:12px}.dev-storage{grid-template-columns:1fr}}
</style>
