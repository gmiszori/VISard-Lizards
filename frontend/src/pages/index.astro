---
import BaseLayout from '../layouts/BaseLayout.astro';
import CanteenCard from '../components/CanteenCard.astro';
import FilterBar from '../components/FilterBar.astro';
import RatingCard from '../rating/RatingCard.astro';
import StarredMealsToday from '../components/StarredMealsToday.astro';
import { loadAppData } from '../data/app-data';
import MenuDate from '../components/MenuDate.astro';
import NearMe from '../location/NearMe.astro';
import DevTools from '../dev/DevTools.astro';
const { canteens, menuDate, today, source, sampleReason } = await loadAppData();
const openCount = canteens.filter((canteen) => canteen.isOpen).length;
---
<BaseLayout title="Campus canteens">
  <div class="section-head" style="margin-top:0"><div><h2 role="heading" aria-level="1" data-i18n="campus">Campus canteens</h2></div><span class="count"><span data-live="open-count">{openCount}</span> <span data-i18n="openCount">open right now</span></span></div>
  <FilterBar />
  <NearMe />
  <DevTools canteens={canteens} source={source} sampleReason={sampleReason} menuDate={menuDate} today={today} />
  <RatingCard />
  {source === 'sample' && (sampleReason === 'invalid'
    ? <p class="data-source-note" data-i18n="sampleMenusInvalid">Showing sample menus: the CampusEats backend sent data this page could not read.</p>
    : <p class="data-source-note" data-i18n="sampleMenus">Showing sample menus: the CampusEats backend is not reachable.</p>)}
  <StarredMealsToday date={menuDate} />
  <section id="favourites-section" hidden>
    <div class="section-head favourites-heading"><div><h2 data-i18n="favourites">Your favourites</h2></div></div>
    <div id="favourites-grid" class="canteen-grid"></div>
  </section>
  <div class="section-head all-canteens-heading"><div><h2 data-i18n="allCanteens">All canteens</h2></div></div>
  <MenuDate date={menuDate} today={today} variant="note" />
  <div id="visible-count" class="count" style="margin:0 0 12px">{canteens.length} canteens</div>
  <p id="favourites-status" role="status" hidden></p>
  <div id="canteen-grid" class="canteen-grid">{canteens.map((canteen) => <CanteenCard canteen={canteen} />)}</div>
  <div id="empty-state" class="empty-state" data-i18n="empty">No canteens match your search. Try another dish or campus.</div>
  <script>
    import { readFavourites, FAVOURITES_KEY } from '../preferences/state';
    const allCards = [...document.querySelectorAll<HTMLElement>('[data-canteen-card]')];
    const allGrid = document.querySelector<HTMLElement>('#canteen-grid');
    const favouritesGrid = document.querySelector<HTMLElement>('#favourites-grid');
    const favouritesSection = document.querySelector<HTMLElement>('#favourites-section');
    let saved: string[];
    try { saved = readFavourites(); } catch { saved = []; }
    const favourites = new Set(saved);
    function renderFavourites() {
      allCards.forEach((card) => {
        const id = card.dataset.canteenId || '';
        const isFavourite = favourites.has(id);
        const button = card.querySelector<HTMLButtonElement>('[data-favorite-toggle]');
        if (button) {
          button.setAttribute('aria-pressed', String(isFavourite));
          button.setAttribute('aria-label', isFavourite ? (document.documentElement.lang === 'de' ? 'Aus Favoriten entfernen' : 'Remove from favourites') : (document.documentElement.lang === 'de' ? 'Zu Favoriten hinzufügen' : 'Add to favourites'));
          button.classList.toggle('is-favourite', isFavourite);
          button.querySelector('span')!.textContent = isFavourite ? '★' : '☆';
        }
        const hasMeals = card.querySelector('[data-meal-row]:not([hidden])') !== null;
        (isFavourite && hasMeals ? favouritesGrid : allGrid)?.append(card);
      });
      const visibleFavourites = favouritesGrid?.querySelectorAll<HTMLElement>('[data-canteen-card]:not([hidden])').length ?? 0;
      if (favouritesSection) favouritesSection.hidden = visibleFavourites === 0;
      document.dispatchEvent(new Event('campuseats:canteen-favourites-changed'));
    }
    document.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-favorite-toggle]');
      if (!button) return;
      const card = button.closest<HTMLElement>('[data-canteen-card]');
      const id = card?.dataset.canteenId;
      if (!id) return;
      const next = new Set(favourites);
      if (next.has(id)) next.delete(id); else next.add(id);
      const status = document.querySelector<HTMLElement>('#favourites-status')!;
      try { localStorage.setItem(FAVOURITES_KEY, JSON.stringify([...next])); }
      catch { status.hidden = false; status.textContent = document.documentElement.lang === 'de' ? 'Favoriten konnten nicht gespeichert werden.' : 'Could not save favourites on this device.'; return; }
      status.hidden = true;
      favourites.clear(); next.forEach(value => favourites.add(value));
      renderFavourites();
    });
    document.addEventListener('languagechange', renderFavourites);
    document.addEventListener('campuseats:preferences-applied', renderFavourites);
    window.addEventListener('storage', event => {
      if (event.key === FAVOURITES_KEY || event.key === null) {
        try { favourites.clear(); readFavourites().forEach(id => favourites.add(id)); renderFavourites(); } catch { /* Storage blocked. */ }
      }
    });
    renderFavourites();
  </script>
</BaseLayout>
<style>.data-source-note{margin:0 0 14px;padding:10px 14px;border:1px solid var(--line);border-radius:12px;color:var(--muted);font-size:13px}</style>
