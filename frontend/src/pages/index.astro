---
import ScrapedMenus from '../components/ScrapedMenus.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CanteenCard from '../components/CanteenCard.astro';
import FilterBar from '../components/FilterBar.astro';
import RatingCard from '../rating/RatingCard.astro';
import StarredMealsToday from '../components/StarredMealsToday.astro';
import { loadAppData } from '../data/app-data';
import MenuDate from '../components/MenuDate.astro';
import NearMe from '../location/NearMe.astro';
import DevTools from '../dev/DevTools.astro';
import DayPicker from '../components/DayPicker.astro';
// Also rendered by /day/[date] (pages/day/[date].astro) with the picked day in Astro.params.date.
const { canteens, menuDate, today, source, sampleReason, days, chosenDay } = await loadAppData(Astro.params.date);
const openCount = canteens.filter((canteen) => canteen.isOpen).length;
---
<BaseLayout title="Campus canteens">
  <div class="section-head" style="margin-top:0"><div><h1 data-i18n="campus">Campus canteens</h1></div><span class="count" hidden={openCount === 0}><span data-live="open-count">{openCount}</span> <span data-i18n="openCount">open right now</span></span></div>
  <FilterBar />
  <NearMe />
  <DevTools canteens={canteens} source={source} sampleReason={sampleReason} menuDate={menuDate} today={today} />
  <RatingCard />
  {source === 'sample' && (sampleReason === 'invalid'
    ? <p class="data-source-note" data-i18n="sampleMenusInvalid">Showing sample menus: the UniEats backend sent data this page could not read.</p>
    : <p class="data-source-note" data-i18n="sampleMenus">Showing sample menus: the UniEats backend is not reachable.</p>)}
  <StarredMealsToday date={menuDate} />
  <section id="favourites-section" hidden>
    <div class="section-head favourites-heading"><div><h2 data-i18n="favourites">Your favourites</h2></div></div>
    <div id="favourites-grid" class="canteen-grid"></div>
  </section>
  <div class="section-head all-canteens-heading"><div><h2 data-i18n="canteensTitle">Canteens</h2></div></div>
  <MenuDate date={menuDate} today={today} variant="note" />
  <DayPicker days={days} menuDate={menuDate} today={today} chosenDay={chosenDay} />
  <div class="menu-list-controls"><div id="visible-count" class="count" role="status" aria-live="polite">{canteens.length} canteens</div><button id="no-menu-toggle" type="button" aria-pressed="false" hidden></button></div>
  <p id="favourites-status" role="status" hidden></p>
  <div id="canteen-grid" class="canteen-grid">{canteens.map((canteen) => <CanteenCard canteen={canteen} day={chosenDay ? menuDate : undefined} />)}</div>
  <div id="empty-state" class="empty-state">
    <p id="empty-message">No canteens match your search. Try another dish or campus.</p>
    <div class="empty-actions"><button type="button" data-reset-filters data-i18n="resetFilters">Show all canteens</button><a href="/settings" data-i18n="checkSettings">Check my settings</a></div>
  </div>
  <ScrapedMenus />
  <button class="back-to-top" type="button" data-back-to-top data-i18n-aria="backToTop" aria-label="Back to top" hidden><span aria-hidden="true">↑</span></button>
  <script>
    import { readFavourites, FAVOURITES_KEY } from '../preferences/state';
    const allCards = [...document.querySelectorAll<HTMLElement>('[data-canteen-card]')];
    const allGrid = document.querySelector<HTMLElement>('#canteen-grid');
    const favouritesGrid = document.querySelector<HTMLElement>('#favourites-grid');
    const favouritesSection = document.querySelector<HTMLElement>('#favourites-section');
    let saved: string[];
    try { saved = readFavourites(); } catch { saved = []; }
    const favourites = new Set(saved);
    function renderFavourites() {
      allCards.forEach((card) => {
        const id = card.dataset.canteenId || '';
        const isFavourite = favourites.has(id);
        const button = card.querySelector<HTMLButtonElement>('[data-favorite-toggle]');
        if (button) {
          button.setAttribute('aria-pressed', String(isFavourite));
          button.setAttribute('aria-label', isFavourite ? (document.documentElement.lang === 'de' ? 'Aus Favoriten entfernen' : 'Remove from favourites') : (document.documentElement.lang === 'de' ? 'Zu Favoriten hinzufügen' : 'Add to favourites'));
          button.classList.toggle('is-favourite', isFavourite);
          button.querySelector('span')!.textContent = isFavourite ? '★' : '☆';
        }
        const hasMeals = card.querySelector('[data-meal-row]:not([hidden])') !== null;
        (isFavourite && hasMeals ? favouritesGrid : allGrid)?.append(card);
      });
      const visibleFavourites = favouritesGrid?.querySelectorAll<HTMLElement>('[data-canteen-card]:not([hidden])').length ?? 0;
      if (favouritesSection) favouritesSection.hidden = visibleFavourites === 0;
      document.dispatchEvent(new Event('campuseats:canteen-favourites-changed'));
    }
    document.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-favorite-toggle]');
      if (!button) return;
      const card = button.closest<HTMLElement>('[data-canteen-card]');
      const id = card?.dataset.canteenId;
      if (!id) return;
      const next = new Set(favourites);
      if (next.has(id)) next.delete(id); else next.add(id);
      const status = document.querySelector<HTMLElement>('#favourites-status')!;
      try { localStorage.setItem(FAVOURITES_KEY, JSON.stringify([...next])); }
      catch { status.hidden = false; status.textContent = document.documentElement.lang === 'de' ? 'Favoriten konnten nicht gespeichert werden.' : 'Could not save favourites on this device.'; return; }
      status.hidden = true;
      favourites.clear(); next.forEach(value => favourites.add(value));
      renderFavourites();
    });
    document.addEventListener('languagechange', renderFavourites);
    document.addEventListener('campuseats:preferences-applied', renderFavourites);
    // Only useful once the page has been scrolled; at the top it just covers content.
    const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
    const toggleBackToTop = () => { if (backToTop) backToTop.hidden = window.scrollY < 400; };
    window.addEventListener('scroll', toggleBackToTop, { passive: true });
    toggleBackToTop();
    backToTop?.addEventListener('click', () => {
      const behavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      window.scrollTo({ top: 0, behavior });
    });
    window.addEventListener('storage', event => {
      if (event.key === FAVOURITES_KEY || event.key === null) {
        try { favourites.clear(); readFavourites().forEach(id => favourites.add(id)); renderFavourites(); } catch { /* Storage blocked. */ }
      }
    });
    renderFavourites();
  </script>
</BaseLayout>
<style>
  .data-source-note{margin:0 0 14px;padding:10px 14px;border:1px solid var(--line);border-radius:12px;color:var(--muted);font-size:13px}
  .menu-list-controls{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 12px}
  #no-menu-toggle{min-height:44px;padding:5px 0;border:0;background:none;color:var(--green);font-size:12px;font-weight:700;text-decoration:underline;text-underline-offset:3px}
  #no-menu-toggle[hidden]{display:none}
  .back-to-top{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));z-index:30;display:grid;place-items:center;width:44px;height:44px;padding:0;border:1px solid var(--line);border-radius:50%;background:var(--paper);color:var(--green);box-shadow:var(--shadow);font:700 22px/1 'DM Sans',sans-serif;cursor:pointer;transition:transform .18s,background .18s}
  .back-to-top[hidden]{display:none}
  .back-to-top:hover{transform:translateY(-2px)}
  .back-to-top:focus-visible{outline:3px solid var(--green);outline-offset:3px}
</style>
