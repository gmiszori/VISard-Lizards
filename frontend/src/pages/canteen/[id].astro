---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MenuItem from '../../components/MenuItem.astro';
import PredictedCrowd from '../../components/PredictedCrowd.astro';
import { CANTEENS, CROWD, LIVE_DATA } from '../../data/canteens';
import { WEEKDAYS, type CrowdPrediction } from '../../crowd/prediction';
export function getStaticPaths() { return CANTEENS.map((canteen) => ({ params: { id: canteen.id }, props: { canteen } })); }
const { canteen } = Astro.props;
const crowd = CROWD[canteen.id];
const live = LIVE_DATA[canteen.id];
const prediction: CrowdPrediction = {
  mensaId: canteen.id, intervalMinutes: 15, timeZone: 'Europe/Zurich', source: 'preview',
  byWeekday: Object.fromEntries(WEEKDAYS.map(day => [day,
    !live?.temporarilyClosed && crowd?.sufficientData ? Object.fromEntries(Object.entries(crowd.typicalByWeekday[day]?.pct ?? {}).filter(([time]) => {
      const minute = Number(time.slice(0, 2)) * 60 + Number(time.slice(3));
      return live?.windows[day].some(([start, end]) => minute >= start && minute < end);
    })) : {},
  ])),
};
---
<BaseLayout title={canteen.name}>
  <a href="/" class="detail-back" data-i18n="back">← All canteens</a>
  <section class="detail-hero"><img src={canteen.imageUrl} alt={`Dining area at ${canteen.name}`} /><div class="detail-overlay"><div><h1>{canteen.name}</h1><p>{canteen.campus} · {canteen.location} · ★ {canteen.rating.toFixed(1)}</p></div><span data-live="status" data-live-id={canteen.id} class={`status ${canteen.isOpen ? 'open' : 'closed'}`}>● <span data-i18n={canteen.isOpen ? 'open' : 'closed'}>{canteen.isOpen ? 'Open now' : 'Closed'}</span></span></div></section>
  <div class="detail-info"><div class="info-box"><small data-i18n="hours">Opening hours</small><strong data-live="hours" data-live-id={canteen.id}>{canteen.hours}</strong></div><div class="info-box"><small data-i18n="crowd">Current crowd</small><strong data-live="crowd" data-live-id={canteen.id} data-i18n={canteen.isOpen ? canteen.occupancy : 'closed'}>{canteen.isOpen ? canteen.occupancy[0].toUpperCase() + canteen.occupancy.slice(1) : 'Closed'}</strong></div></div>
  <PredictedCrowd prediction={prediction} />
  <section><h2 class="menu-section-title"><span data-i18n="todayMenu">Today’s menu</span> <span class="count">· {canteen.menu.length} <span data-i18n="dishes">dishes</span></span></h2>
    {canteen.menu.length ? <><div class="menu-list" data-preference-list data-meal-list>{canteen.menu.map((item) => <MenuItem item={item} />)}</div><div class="empty-state preference-empty" data-no-preference-meals hidden data-i18n="noPreferenceMeals">No dishes match your food preferences.</div></> : <div class="empty-state" style="display:block" data-i18n="menuEmpty">No menu available today.</div>}
  </section>
</BaseLayout>
