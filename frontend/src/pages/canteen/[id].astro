---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MenuItem from '../../components/MenuItem.astro';
import { CANTEENS } from '../../data/canteens';
export function getStaticPaths() { return CANTEENS.map((canteen) => ({ params: { id: canteen.id }, props: { canteen } })); }
const { canteen } = Astro.props;
---
<BaseLayout title={canteen.name}>
  <a href="/" class="detail-back" data-i18n="back">← All canteens</a>
  <section class="detail-hero"><img src={canteen.imageUrl} alt={`Dining area at ${canteen.name}`} /><div class="detail-overlay"><div><h1>{canteen.name}</h1><p>{canteen.campus} · {canteen.location} · ★ {canteen.rating.toFixed(1)}</p></div><span data-live="status" data-live-id={canteen.id} class={`status ${canteen.isOpen ? 'open' : 'closed'}`}>● <span data-i18n={canteen.isOpen ? 'open' : 'closed'}>{canteen.isOpen ? 'Open now' : 'Closed'}</span></span></div></section>
  <div class="detail-info"><div class="info-box"><small data-i18n="hours">Opening hours</small><strong data-live="hours" data-live-id={canteen.id}>{canteen.hours}</strong></div><div class="info-box"><small data-i18n="crowd">Current crowd</small><strong data-live="crowd" data-live-id={canteen.id} data-i18n={canteen.occupancy}>{canteen.occupancy[0].toUpperCase() + canteen.occupancy.slice(1)}</strong></div></div>
  <section><h2 class="menu-section-title"><span data-i18n="todayMenu">Today’s menu</span> <span class="count">· {canteen.menu.length} <span data-i18n="dishes">dishes</span></span></h2>
    {canteen.menu.length ? <><div class="menu-list" data-preference-list>{canteen.menu.map((item) => <MenuItem item={item} />)}</div><div class="empty-state preference-empty" data-no-preference-meals hidden data-i18n="noPreferenceMeals">No dishes match your food preferences.</div></> : <div class="empty-state" style="display:block" data-i18n="menuEmpty">No menu available today.</div>}
  </section>
</BaseLayout>
