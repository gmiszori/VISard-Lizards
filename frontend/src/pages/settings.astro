---
import BaseLayout from '../layouts/BaseLayout.astro';
import OnboardingEntry from '../onboarding/components/OnboardingEntry.astro';
import StarredMealsSettings from '../components/StarredMealsSettings.astro';
import YourRatings from '../components/YourRatings.astro';
---
<BaseLayout title="Settings">
  <a href="/" class="detail-back sticky-back-link" data-i18n="back">← All canteens</a>
  <section class="settings-intro">
    <div><span class="eyebrow" data-i18n="settings">Settings</span>
      <h1 data-i18n="settingsTitle">Your settings</h1>
      <p data-i18n="settingsIntro">Choose which meals you want to see. Your choices are saved on this device.</p>
    </div>
  </section>
  <div class="settings-sections">
    <OnboardingEntry />
    <fieldset class="settings-group appearance-settings">
      <legend data-i18n="appearance">Appearance</legend>
      <label class="appearance-control" for="theme-select">
        <span data-i18n="themeLabel">Theme</span>
        <select id="theme-select" data-i18n-aria="themeLabel" aria-label="Theme">
          <option value="light" data-i18n="lightTheme">Light</option>
          <option value="dark" data-i18n="darkTheme">Dark</option>
        </select>
      </label>
      <label class="appearance-control" for="language-select">
        <span data-i18n="languageLabel">Language</span>
        <select id="language-select" data-i18n-aria="languageLabel" aria-label="Language">
          <option value="en" data-i18n="english">English</option>
          <option value="de" data-i18n="german">German</option>
        </select>
      </label>
    </fieldset>
    <StarredMealsSettings />
    <YourRatings />
  </div>
  <form id="preferences-form" class="settings-form">
    <fieldset class="settings-group price-category">
      <legend data-i18n="priceCategory">Price category</legend>
      <p data-i18n="priceCategoryHint">Show only your selected price on every dish. Student is the default.</p>
      <label class="select-option"><span data-i18n="yourPrice">Your price</span><select name="priceTier" data-price-tier>
        <option value="student" data-i18n="student">Student</option>
        <option value="worker" data-i18n="worker">Staff</option>
        <option value="external" data-i18n="external">External</option>
      </select></label>
    </fieldset>
    <fieldset class="settings-group">
      <legend data-i18n="foodPreferences">Food preferences</legend>
      <p data-i18n="preferencesHint">Select every type of meal you want included.</p>
      <div class="preference-options">
        <label class="setting-option preference-option preference-vegan"><span class="preference-icon" aria-hidden="true">🌿</span><span class="setting-copy"><strong data-i18n="vegan">Vegan</strong><small data-i18n="plantBased">Plant-based</small></span><input type="checkbox" name="vegan" value="vegan" /></label>
        <label class="setting-option preference-option preference-vegetarian"><span class="preference-icon" aria-hidden="true">🥬</span><span class="setting-copy"><strong data-i18n="vegetarian">Vegetarian</strong><small data-i18n="meatFree">Meat-free</small></span><input type="checkbox" name="vegetarian" value="vegetarian" /></label>
        <label class="setting-option preference-option preference-meat"><span class="preference-icon" aria-hidden="true">🍗</span><span class="setting-copy"><strong data-i18n="meat">Meat</strong><small data-i18n="meatDishes">Including meat dishes</small></span><input type="checkbox" name="meat" value="meat" /></label>
      </div>
    </fieldset>
    <fieldset class="settings-group">
      <legend data-i18n="canteenFilters">Canteen filters</legend>
      <p data-i18n="filtersHint">Choose one or more campus locations to include.</p>
      <div class="campus-options">
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true">⌂</span><span class="setting-copy"><strong data-i18n="zentrum">Zentrum</strong></span><input type="checkbox" name="locations" value="zentrum" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true">⌂</span><span class="setting-copy"><strong data-i18n="hoenggerberg">Hönggerberg</strong></span><input type="checkbox" name="locations" value="hoenggerberg" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true">⌂</span><span class="setting-copy"><strong data-i18n="irchel">Irchel</strong></span><input type="checkbox" name="locations" value="irchel" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true">⌂</span><span class="setting-copy"><strong>Oerlikon</strong></span><input type="checkbox" name="locations" value="oerlikon" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true">⌂</span><span class="setting-copy"><strong>Basel</strong></span><input type="checkbox" name="locations" value="basel" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true">⌂</span><span class="setting-copy"><strong>Toni-Areal</strong></span><input type="checkbox" name="locations" value="toni-areal" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true">⌂</span><span class="setting-copy"><strong>Europaallee</strong></span><input type="checkbox" name="locations" value="europaallee" /></label>
      </div>
      <label class="setting-option compact-option open-only-option"><span class="compact-icon" aria-hidden="true">◷</span><span class="setting-copy"><strong data-i18n="openOnly">Only show open canteens</strong></span><input type="checkbox" name="openOnly" value="true" /></label>
    </fieldset>
    <fieldset class="settings-group">
      <legend data-i18n="viewMode">Overview layout</legend>
      <div class="view-mode-options">
        <label class="view-mode-option"><input type="radio" name="viewMode" value="standard" /><span data-i18n="viewStandard">Standard</span></label>
        <label class="view-mode-option"><input type="radio" name="viewMode" value="compact" /><span data-i18n="compact">Compact</span></label>
        <label class="view-mode-option"><input type="radio" name="viewMode" value="list" /><span data-i18n="viewList">List</span></label>
      </div>
    </fieldset>
    <fieldset class="settings-group">
      <legend data-i18n="devMode">Dev mode</legend>
      <p data-i18n="devModeDescription">Show diagnostics for live data, location, storage and backend connectivity.</p>
      <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true">⌁</span><span class="setting-copy"><strong data-i18n="devTools">Developer tools</strong></span><input type="checkbox" name="devMode" value="true" /></label>
    </fieldset>
    <p class="settings-saved" id="settings-saved" aria-live="polite" data-i18n="settingsSaved" hidden>Saved</p>
  </form>
</BaseLayout>
<style>
  .settings-intro{max-width:820px}
  .settings-sections{display:grid;gap:14px;max-width:820px;margin:0 0 14px}
  .settings-sections :global(.onboarding-restart){justify-self:start;margin:0;min-height:44px;padding:10px 15px;border-color:var(--line);background:var(--paper);color:var(--green);font-size:13px;transition:background .18s,border-color .18s,transform .18s}
  .settings-sections :global(.onboarding-restart:hover){background:#edf4ed;border-color:#b9d0bf;transform:translateY(-1px)}
  .appearance-settings{padding-bottom:17px}
  .appearance-control{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:44px;color:var(--muted);font-size:13px;font-weight:600}
  .appearance-control select{min-width:150px;height:42px;padding:0 38px 0 13px;border:1px solid var(--line);border-radius:11px;background:var(--paper);color:var(--ink);font:600 13px 'DM Sans',sans-serif}
  .appearance-control select:focus-visible{outline:3px solid #7eb594;outline-offset:2px}
  :global(:root[data-theme="dark"] .settings-sections .onboarding-restart:hover){background:#141b16;border-color:#3e5c46}
  .price-category .select-option{margin:0;padding:0;border:0;min-height:44px;font-size:13px;font-weight:700}
  .price-category select{min-height:44px;min-width:140px}
  .view-mode-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;max-width:450px;border:1px solid var(--line);border-radius:8px;overflow:hidden}
  .view-mode-option{position:relative;min-width:0;cursor:pointer}
  .view-mode-option+ .view-mode-option{border-left:1px solid var(--line)}
  .view-mode-option input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
  .view-mode-option span{display:grid;place-items:center;min-height:44px;padding:0 8px;background:var(--paper);color:var(--ink);font-size:13px;font-weight:700}
  .view-mode-option input:checked+span{background:var(--green);color:white}
  .view-mode-option input:focus-visible+span{outline:3px solid #7eb594;outline-offset:-3px}
</style>
