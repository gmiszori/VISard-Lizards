---
import BaseLayout from '../layouts/BaseLayout.astro';
import OnboardingEntry from '../onboarding/components/OnboardingEntry.astro';
import StarredMealsSettings from '../components/StarredMealsSettings.astro';
import YourRatings from '../components/YourRatings.astro';
import ProfileMealSettings from '../components/ProfileMealSettings.astro';
---
<BaseLayout title="Settings">
  <a href="/" class="detail-back sticky-back-link settings-back-link" data-i18n="back">← All canteens</a>
  <section class="settings-intro">
    <div><span class="eyebrow" data-i18n="settings">Settings</span>
      <h1 data-i18n="settingsTitle">Your settings</h1>
      <p data-i18n="settingsIntro">Choose which meals you want to see. Your choices are saved on this device.</p>
    </div>
  </section>
  <div class="settings-sections">
    <OnboardingEntry />
    <fieldset class="settings-group appearance-settings">
      <legend data-i18n="appearance">Appearance</legend>
      <label class="appearance-control" for="theme-select">
        <span data-i18n="themeLabel">Theme</span>
        <select id="theme-select" data-i18n-aria="themeLabel" aria-label="Theme">
          <option value="system" data-i18n="systemTheme">System</option>
          <option value="light" data-i18n="lightTheme">Light</option>
          <option value="dark" data-i18n="darkTheme">Dark</option>
        </select>
      </label>
      <label class="appearance-control" for="language-select">
        <span data-i18n="languageLabel">Language</span>
        <select id="language-select" data-i18n-aria="languageLabel" aria-label="Language">
          <option value="en" data-i18n="english">English</option>
          <option value="de" data-i18n="german">German</option>
        </select>
      </label>
    </fieldset>
    <StarredMealsSettings />
    <YourRatings />
  </div>
  <form id="preferences-form" class="settings-form">
    <fieldset class="settings-group price-category">
      <legend data-i18n="priceCategory">Price &amp; budget</legend>
      <p data-i18n="priceCategoryHint">Show only your selected price on every dish. Student is the default.</p>
      <label class="select-option"><span data-i18n="yourPrice">Your price</span><select name="priceTier" data-price-tier>
        <option value="student" data-i18n="student">Student</option>
        <option value="worker" data-i18n="worker">Staff</option>
        <option value="external" data-i18n="external">External</option>
      </select></label>
      <ProfileMealSettings section="budget" />
    </fieldset>
    <fieldset class="settings-group">
      <legend data-i18n="foodPreferences">Food preferences</legend>
      <p data-i18n="preferencesHint">Select every type of meal you want included.</p>
      <div class="preference-options">
        <label class="setting-option preference-option preference-vegan"><span class="preference-icon" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center"><svg viewBox="0 0 24 24"><path d="M20.5 3.5C12 3.5 5.5 6.5 5.5 13a5.5 5.5 0 0 0 5.5 5.5c6.5 0 9.5-6.5 9.5-15Z"/><path d="M3.5 21c3.5-6 7.5-9.5 13-13"/></svg></span><span class="setting-copy"><strong data-i18n="vegan">Vegan</strong><small data-i18n="plantBased">Plant-based</small></span><input type="checkbox" name="vegan" value="vegan" /></label>
        <label class="setting-option preference-option preference-vegetarian"><span class="preference-icon" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center"><svg viewBox="0 0 24 24"><path d="M20.5 3.5C12 3.5 5.5 6.5 5.5 13a5.5 5.5 0 0 0 5.5 5.5c6.5 0 9.5-6.5 9.5-15Z"/><path d="M3.5 21c3.5-6 7.5-9.5 13-13"/></svg></span><span class="setting-copy"><strong data-i18n="vegetarian">Vegetarian</strong><small data-i18n="meatFree">Meat-free</small></span><input type="checkbox" name="vegetarian" value="vegetarian" /></label>
        <label class="setting-option preference-option preference-meat"><span class="preference-icon" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center"><svg viewBox="0 0 24 24"><path d="M15.5 4.5c2.7-1.2 5.2.4 5.2 2.6 0 1.4-.8 2.1-1.8 2.8-.8.5-1.3 1.1-1.4 2.1-.4 3.6-3.2 7-7 7-3 0-5.5-2-5.5-5 0-4.5 4.7-7.6 10.5-9.5Z"/><path d="m6.4 17.6-2 2m4.2-.6-1.8 2"/></svg></span><span class="setting-copy"><strong data-i18n="meat">Meat</strong><small data-i18n="meatDishes">Including meat dishes</small></span><input type="checkbox" name="meat" value="meat" /></label>
      </div>
      <ProfileMealSettings section="exclusions" />
    </fieldset>
    <fieldset class="settings-group">
      <legend data-i18n="canteenFilters">Canteen filters</legend>
      <p data-i18n="filtersHint">Choose one or more campus locations to include.</p>
      <button type="button" class="campus-toggle-all" data-campus-toggle-all>Select all</button>
      <div class="campus-options">
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4.5 10 7.5-7 7.5 7v10h-15V10Z"/></svg></span><span class="setting-copy"><strong data-i18n="zentrum">Zentrum</strong></span><input type="checkbox" name="locations" value="zentrum" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4.5 10 7.5-7 7.5 7v10h-15V10Z"/></svg></span><span class="setting-copy"><strong data-i18n="hoenggerberg">Hönggerberg</strong></span><input type="checkbox" name="locations" value="hoenggerberg" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4.5 10 7.5-7 7.5 7v10h-15V10Z"/></svg></span><span class="setting-copy"><strong data-i18n="irchel">Irchel</strong></span><input type="checkbox" name="locations" value="irchel" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4.5 10 7.5-7 7.5 7v10h-15V10Z"/></svg></span><span class="setting-copy"><strong>Oerlikon</strong></span><input type="checkbox" name="locations" value="oerlikon" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4.5 10 7.5-7 7.5 7v10h-15V10Z"/></svg></span><span class="setting-copy"><strong>Basel</strong></span><input type="checkbox" name="locations" value="basel" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4.5 10 7.5-7 7.5 7v10h-15V10Z"/></svg></span><span class="setting-copy"><strong>Toni-Areal</strong></span><input type="checkbox" name="locations" value="toni-areal" /></label>
        <label class="setting-option compact-option"><span class="compact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4.5 10 7.5-7 7.5 7v10h-15V10Z"/></svg></span><span class="setting-copy"><strong>Europaallee</strong></span><input type="checkbox" name="locations" value="europaallee" /></label>
      </div>
      <label class="setting-option compact-option open-only-option"><span class="compact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z"/><path d="M12 8v4h3"/></svg></span><span class="setting-copy"><strong data-i18n="openOnly">Only show open canteens</strong></span><input type="checkbox" name="openOnly" value="true" /></label>
    </fieldset>
    <fieldset class="settings-group">
      <legend data-i18n="viewMode">Overview layout</legend>
      <div class="view-mode-options">
        <label class="view-mode-option"><input type="radio" name="viewMode" value="standard" /><span data-i18n="viewStandard">Standard</span></label>
        <label class="view-mode-option"><input type="radio" name="viewMode" value="compact" /><span data-i18n="compact">Compact</span></label>
        <label class="view-mode-option"><input type="radio" name="viewMode" value="list" /><span data-i18n="viewList">List</span></label>
      </div>
    </fieldset>
    <fieldset class="settings-group">
      <legend data-i18n="devMode">Dev mode</legend>
      <p data-i18n="devModeDescription">Show diagnostics for live data, location, storage and backend connectivity.</p>
      <label class="setting-option compact-option"><span class="compact-icon dev-tools-icon" aria-hidden="true">&lt;/&gt;</span><span class="setting-copy"><strong data-i18n="devTools">Developer tools</strong></span><input type="checkbox" name="devMode" value="true" /></label>
    </fieldset>
    <p class="settings-saved" id="settings-saved" aria-live="polite" data-i18n="settingsSaved" hidden>Saved</p>
  </form>
  <script>
    import { mountProfileMealSettings } from '../scripts/profile-meal-settings';
    mountProfileMealSettings();
    // "Select all" / "Deselect all" for the campus locations. Each changed checkbox fires the form's
    // normal change event, so scripts/preferences.ts saves it exactly like a single click.
    const toggleAll = document.querySelector<HTMLButtonElement>('[data-campus-toggle-all]');
    const campuses = () => [...document.querySelectorAll<HTMLInputElement>('.campus-options input[name="locations"]')];
    const allChecked = () => campuses().every(input => input.checked);
    function renderToggleAll() {
      if (!toggleAll) return;
      const de = document.documentElement.lang === 'de';
      const all = allChecked();
      toggleAll.textContent = all ? (de ? 'Alle abwählen' : 'Deselect all') : (de ? 'Alle auswählen' : 'Select all');
      toggleAll.setAttribute('aria-label', all
        ? (de ? 'Alle Campus-Standorte abwählen' : 'Deselect all campus locations')
        : (de ? 'Alle Campus-Standorte auswählen' : 'Select all campus locations'));
    }
    toggleAll?.addEventListener('click', () => {
      const select = !allChecked();
      campuses().filter(input => input.checked !== select).forEach(input => {
        input.checked = select;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
      renderToggleAll();
    });
    document.querySelector('.campus-options')?.addEventListener('change', renderToggleAll);
    document.addEventListener('campuseats:preferences-applied', renderToggleAll);
    document.addEventListener('languagechange', renderToggleAll);
    renderToggleAll();
  </script>
</BaseLayout>
<style>
  .settings-intro,.settings-sections,.settings-form{width:100%;max-width:none}
  .settings-sections{display:grid;gap:14px;margin:0 0 14px}
  .settings-sections :global(.starred-meals-settings){width:100%;max-width:none;margin-bottom:0}
  .settings-sections :global(.onboarding-restart){justify-self:start;margin:0;min-height:44px;padding:10px 15px;border-color:var(--line);background:var(--paper);color:var(--green);font-size:13px;transition:background .18s,border-color .18s,transform .18s}
  .settings-sections :global(.onboarding-restart:hover){background:#edf4ed;border-color:#b9d0bf;transform:translateY(-1px)}
  .appearance-settings{padding-bottom:17px}
  .campus-toggle-all{margin:0 0 12px;min-height:40px;padding:8px 14px;border:1px solid var(--line);border-radius:10px;background:var(--paper);color:var(--green);font:700 13px 'DM Sans',sans-serif;cursor:pointer}
  .campus-toggle-all:hover{border-color:var(--green)}
  .campus-toggle-all:focus-visible{outline:3px solid #7eb594;outline-offset:2px}
  .appearance-control{position:relative;display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:44px;color:var(--muted);font-size:13px;font-weight:600}
  .appearance-control:focus-within{z-index:1}
  .appearance-control select{min-width:150px;height:42px;padding:0 38px 0 13px;border:1px solid var(--line);border-radius:11px;background:var(--paper);color:var(--ink);font:600 13px 'DM Sans',sans-serif}
  .appearance-control select:focus-visible{outline:3px solid #7eb594;outline-offset:2px}
  :global(:root[data-theme="dark"] .settings-sections .onboarding-restart:hover){background:#141b16;border-color:#3e5c46}
  .price-category .select-option{margin:0;padding:0;border:0;min-height:44px;font-size:13px;font-weight:700}
  .price-category select{min-height:44px;min-width:140px}
  .dev-tools-icon{font:700 14px ui-monospace,SFMono-Regular,Consolas,monospace}
  .view-mode-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;max-width:450px;border:1px solid var(--line);border-radius:8px;overflow:hidden}
  .view-mode-option{position:relative;min-width:0;cursor:pointer}
  .view-mode-option+ .view-mode-option{border-left:1px solid var(--line)}
  .view-mode-option input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
  .view-mode-option span{display:grid;place-items:center;min-height:44px;padding:0 8px;background:var(--paper);color:var(--ink);font-size:13px;font-weight:700}
  .view-mode-option input:checked+span{background:var(--green);color:white}
  .view-mode-option input:focus-visible+span{outline:3px solid #7eb594;outline-offset:-3px}
</style>
