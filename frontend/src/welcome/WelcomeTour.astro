<div class="welcome-tour" data-welcome-tour hidden>
  <div class="welcome-backdrop"></div>
  <span class="welcome-settings-spotlight" data-welcome-settings-spotlight aria-hidden="true" hidden></span>
  <span class="welcome-pointer" aria-hidden="true"></span>
  <section class="welcome-dialog" role="dialog" aria-modal="true" aria-labelledby="welcome-title" tabindex="-1" data-welcome-dialog>
    <div class="welcome-topline"><span data-welcome-progress></span><button type="button" class="welcome-skip" data-welcome-skip>Skip tour</button></div>
    <div class="welcome-image" data-welcome-image hidden><img src="/welcome-bowl.jpg" alt="" width="880" height="660" onerror="this.hidden=true;" /></div>
    <div class="welcome-content">
      <h2 id="welcome-title" data-welcome-title></h2>
      <p data-welcome-description></p>
      <p class="welcome-guide" data-welcome-guide hidden></p>
      <a class="welcome-help" data-welcome-help hidden target="_blank" rel="noopener noreferrer"></a>
      <button class="welcome-install" type="button" data-welcome-install hidden></button>
      <button class="welcome-primary" type="button" data-welcome-next></button>
    </div>
  </section>
</div>
<script>
  import { mountWelcomeTour } from './tour';
  mountWelcomeTour();
</script>
<style>
  .welcome-tour[hidden],.welcome-tour [hidden]{display:none!important}
  .welcome-tour{position:fixed;inset:0;z-index:100;pointer-events:none}
  :global(body.welcome-open){overflow:hidden}
  .welcome-backdrop{position:absolute;inset:0;background:#10251b80;backdrop-filter:blur(2px);pointer-events:auto}
  .welcome-settings-spotlight{position:absolute;z-index:1;display:flex;align-items:center;justify-content:center;border-radius:11px;background:var(--paper,#fff);color:var(--green,#17664f);font:700 12px 'DM Sans',sans-serif;box-shadow:0 0 0 4px #e1a33d,0 0 0 8px #fff;white-space:nowrap}
  .welcome-dialog{position:absolute;right:max(24px,env(safe-area-inset-right));top:96px;width:min(390px,calc(100vw - 32px));max-height:calc(100dvh - 116px);overflow:auto;background:var(--paper,#fff);color:var(--ink,#14241b);border:1px solid var(--line,#dce5df);border-radius:8px;box-shadow:0 22px 70px #071a1340;pointer-events:auto;animation:welcome-in .28s ease both}
  .welcome-dialog:focus{outline:none}
  .welcome-topline{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:19px 22px 0;color:var(--muted,#5b6a60);font-size:12px;font-weight:700}
  .welcome-tour[data-standalone="true"] .welcome-topline{display:none}
  .welcome-skip{display:inline-flex;align-items:center;min-height:44px;padding:0 0 0 12px;margin:-11px 0;border:0;background:transparent;color:inherit;font:inherit;text-decoration:underline;cursor:pointer}
  .welcome-content{padding:8px 22px 24px}
  .welcome-content h2{margin:8px 0 10px;font:800 24px/1.17 Manrope,sans-serif;letter-spacing:0}
  .welcome-content p{margin:0 0 13px;color:var(--muted,#5b6a60);font-size:14px;line-height:1.5}
  .welcome-guide{padding:12px 14px;border-left:3px solid var(--green,#17664f);background:color-mix(in srgb,var(--green,#17664f) 8%,var(--paper,#fff));color:var(--ink,#14241b)!important}
  .welcome-help{display:inline-flex;align-items:center;min-height:44px;margin:-14px 0 3px;color:var(--green,#17664f);font-size:13px;font-weight:700}
  .welcome-primary,.welcome-install{display:block;width:100%;min-height:44px;padding:10px 14px;border-radius:7px;font:700 14px 'DM Sans',sans-serif;cursor:pointer}
  .welcome-primary{border:1px solid var(--green,#17664f);background:var(--green,#17664f);color:#fff}
  :global(:root[data-theme="dark"]) .welcome-primary{color:var(--paper)}
  .welcome-install{margin:0 0 10px;border:1px solid var(--green,#17664f);background:var(--paper,#fff);color:var(--green,#17664f)}
  .welcome-primary:focus-visible,.welcome-install:focus-visible,.welcome-skip:focus-visible{outline:3px solid #e1a33d;outline-offset:3px}
  .welcome-image{height:170px;margin:14px 22px 0;overflow:hidden;border-radius:6px;background:linear-gradient(145deg,#1d765a,#124a3b)}
  .welcome-image img{width:100%;height:100%;object-fit:cover;object-position:center 47%}
  .welcome-tour[data-step="finish"] .welcome-dialog{top:50%;left:50%;right:auto;transform:translate(-50%,-50%);animation:welcome-finish .36s ease both}
  .welcome-tour[data-step="settings"] .welcome-dialog{top:132px}
  .welcome-pointer{display:none;position:absolute;top:52px;right:64px;color:#fff;font:700 34px/1 'DM Sans',sans-serif;text-shadow:0 2px 8px #10251b80}
  .welcome-tour[data-step="settings"] .welcome-pointer,.welcome-tour[data-step="install"] .welcome-pointer{display:block}
  .welcome-tour[data-step="settings"] .welcome-pointer{right:auto}
  .welcome-pointer::before{content:"↑"}
  .welcome-tour[data-step="install"][data-anchor="bottom"] .welcome-dialog{top:auto;bottom:max(24px,env(safe-area-inset-bottom));max-height:calc(100dvh - 48px)}
  .welcome-tour[data-step="install"][data-anchor="bottom"] .welcome-pointer{top:auto;bottom:2px;right:calc(50% - 10px)}
  .welcome-tour[data-step="install"][data-anchor="bottom"] .welcome-pointer::before{content:"↓"}
  @media(max-width:600px){.welcome-dialog{top:calc(env(safe-area-inset-top) + 96px);right:16px}.welcome-tour[data-step="settings"] .welcome-dialog{top:calc(env(safe-area-inset-top) + 132px)}.welcome-content h2{font-size:21px}.welcome-image{height:145px}}
  /* Phones held sideways are only ~375 px high: without the photo and the 96 px top gap (moved to the left, so the
     arrow on the right stays visible) the Continue button stays in view instead of hiding below the dialog's edge. */
  @media(max-height:520px){
    .welcome-image{display:none}
    .welcome-tour:not([data-step="settings"]):not([data-step="finish"]):not([data-anchor="bottom"]) .welcome-dialog{top:12px;left:16px;right:auto;max-height:calc(100dvh - 24px)}
  }
  @media(prefers-reduced-motion:reduce){.welcome-dialog,.welcome-tour[data-step="finish"] .welcome-dialog{animation:none}}
  @keyframes welcome-in{from{opacity:0;translate:0 8px}to{opacity:1;translate:0 0}}
  @keyframes welcome-finish{from{opacity:0;transform:translate(-50%,-48%)}to{opacity:1;transform:translate(-50%,-50%)}}
</style>
