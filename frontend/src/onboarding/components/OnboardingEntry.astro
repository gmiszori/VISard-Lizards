---
import { t } from '../i18n';
import '../onboarding.css';
---
<a href="/onboarding?restart=1" class="onboarding-restart" data-onboarding-restart>
  <span aria-hidden="true">↻</span>
  <span data-ob-i18n="personalizeMenu">{t('personalizeMenu')}</span>
</a>
<script>
  import { translate } from '../i18n';
  const update = () => document.querySelectorAll<HTMLElement>('[data-onboarding-restart]').forEach(translate);
  update();
  document.addEventListener('languagechange', update);
</script>
