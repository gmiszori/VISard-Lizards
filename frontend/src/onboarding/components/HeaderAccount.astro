---
import '../onboarding.css';
---
<nav class="header-account" aria-label="Your CampusEats" data-account-aria="navigation">
  <a class="personalization-link" href="/onboarding" data-account-text="personalization">PERSONALIZATION</a>
  <button class="login-trigger" type="button" data-login-open aria-haspopup="dialog" aria-controls="login-dialog">Login</button>
</nav>
<dialog class="login-dialog" id="login-dialog" aria-labelledby="login-title" aria-describedby="login-description">
  <button class="login-close" type="button" data-login-close aria-label="Close login" data-account-aria="close">×</button>
  <div class="login-mark" aria-hidden="true">✳</div>
  <p class="login-eyebrow">CAMPUS<span>EATS</span></p>
  <h2 id="login-title" data-account-text="welcome">Welcome back.</h2>
  <p class="login-description" id="login-description" data-account-text="intro">Your campus, your lunch. All in one place.</p>
  <div data-login-guest>
    <form class="login-form" data-login-form>
      <label for="login-email" data-account-text="email">Email address</label>
      <input id="login-email" type="email" autocomplete="username" inputmode="email" placeholder="you@university.ch" required />
      <label for="login-password" data-account-text="password">Password</label>
      <div class="login-password-field">
        <input id="login-password" type="password" autocomplete="current-password" required />
        <button type="button" data-login-reveal aria-controls="login-password" aria-pressed="false" data-account-text="show">Show</button>
      </div>
      <button class="login-primary" type="submit" data-account-text="login">Login</button>
      <p class="login-feedback" data-login-feedback role="status" hidden></p>
    </form>
    <div class="login-helper">
      <div><strong data-account-text="quickAccess">Just trying it out?</strong><p data-account-text="helperHint">Enter a demo session. No details needed.</p></div>
      <button class="login-pass" type="button" data-login-pass>pass <span aria-hidden="true">↗</span></button>
    </div>
    <p class="login-note" data-account-text="previewNote">Login preview · Account connection coming soon.</p>
  </div>
  <div class="login-session" data-login-session hidden>
    <span class="login-demo-badge" data-account-text="demoBadge">Demo session active</span>
    <p data-account-text="sessionHint">Make yourself at home. Your preferences stay on this device.</p>
    <a class="login-primary" href="/onboarding" data-account-text="personalize">Personalize my lunch</a>
    <button class="login-signout" type="button" data-login-signout data-account-text="signout">Leave demo session</button>
  </div>
</dialog>
<p class="login-toast" data-login-toast role="status" hidden></p>
<script>
  import '../login';
</script>
