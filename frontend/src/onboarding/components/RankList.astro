---
import { PRIORITIES } from '../profile';
import { t } from '../i18n';
---
<fieldset class="ob-field">
  <legend data-ob-i18n="priorities">{t('priorities')}</legend>
  <p class="ob-note" data-ob-i18n="rankHint">{t('rankHint')}</p>
  <ol class="ob-rank" data-rank-list>
    {PRIORITIES.map(priority => <li data-priority={priority}>
      <button type="button" class="ob-rank-grip" data-rank-handle aria-label={`${t('reorder')}: ${t(priority)}`}><span aria-hidden="true">⠿</span></button>
      <span class="ob-rank-number" aria-hidden="true"></span><strong data-ob-i18n={priority}>{t(priority)}</strong>
      <button type="button" data-rank-move="-1" aria-label={`${t('up')}: ${t(priority)}`}>↑</button>
      <button type="button" data-rank-move="1" aria-label={`${t('down')}: ${t(priority)}`}>↓</button>
    </li>)}
  </ol>
  <p class="visually-hidden" data-rank-status role="status" aria-live="polite" aria-atomic="true"></p>
  <p class="ob-note" data-ob-i18n="signalHint">{t('signalHint')}</p>
</fieldset>
