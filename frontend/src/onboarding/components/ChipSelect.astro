---
import { t, type Key } from '../i18n';
interface Props {
  name: string;
  labelKey: Key;
  mode?: 'single' | 'multi';
  className?: string;
  options: { value: string; key?: Key; label?: string; count?: number; descriptionKey?: Key }[];
}
const { name, labelKey, mode = 'multi', className, options } = Astro.props;
---
<fieldset class:list={['ob-field', className]} data-chip-group={name} data-mode={mode}>
  <legend data-ob-i18n={labelKey}>{t(labelKey)}</legend>
  <div class="ob-chips" role={mode === 'single' ? 'radiogroup' : 'group'} aria-label={t(labelKey)} data-ob-aria={labelKey}>
    {options.map(option => <button type="button" class="ob-chip" data-value={option.value}
      role={mode === 'single' ? 'radio' : undefined} aria-checked={mode === 'single' ? 'false' : undefined} aria-pressed="false">
      <span data-ob-i18n={option.key}>{option.key ? t(option.key) : option.label}</span>
      {option.descriptionKey && <small class="ob-chip-description" data-ob-i18n={option.descriptionKey}>{t(option.descriptionKey)}</small>}
      {option.count !== undefined && <small>{option.count} <span data-ob-i18n={option.count === 1 ? 'mensa' : 'mensas'}>{t(option.count === 1 ? 'mensa' : 'mensas')}</span></small>}
    </button>)}
  </div>
</fieldset>
