---
import { t } from '../i18n';
---
<template id="ob-rating-template">
  <article class="ob-rating-row">
    <h3 data-mensa-name></h3>
    <fieldset class="ob-field" data-chip-group="rating" data-mode="single" data-clearable="true">
      <legend data-ob-i18n="ratings">{t('ratings')}</legend>
      <div class="ob-stars" role="radiogroup" aria-label={t('ratings')}>
        {[1, 2, 3, 4, 5].map(value => <button type="button" class="ob-star" data-value={value}
          role="radio" aria-checked="false" aria-label={`${value} ${t('outOfFiveStars')}`}>
          <span data-star aria-hidden="true">☆</span>
        </button>)}
      </div>
      <p class="ob-rating-value" data-rating-value aria-live="polite">{t('notRated')}</p>
    </fieldset>
  </article>
</template>
