<div class="recipe-menu" data-recipe-menu role="menu" hidden>
  <button type="button" role="menuitem" data-recipe-open>Recreate as recipe</button>
</div>
<dialog class="recipe-dialog" data-recipe-dialog aria-labelledby="recipe-dialog-title">
  <div class="recipe-dialog-head">
    <div>
      <p class="recipe-kicker" data-recipe-kicker>AI recipe</p>
      <h2 id="recipe-dialog-title" data-recipe-dish></h2>
    </div>
    <button type="button" class="recipe-close" data-recipe-close aria-label="Close">×</button>
  </div>
  <p class="recipe-disclaimer" data-recipe-disclaimer>Inspired by the dish, not its official recipe. Check ingredients and allergens yourself.</p>
  <div class="recipe-controls">
    <label for="recipe-servings" data-recipe-servings-label>Servings</label>
    <input id="recipe-servings" data-recipe-servings type="number" min="1" max="8" value="2" inputmode="numeric" />
    <button type="button" data-recipe-generate>Generate recipe</button>
  </div>
  <p class="recipe-status" data-recipe-status role="status" aria-live="polite"></p>
  <div class="recipe-result" data-recipe-result hidden>
    <div class="recipe-result-actions"><button type="button" data-recipe-download>Download PDF</button></div>
    <h3 data-recipe-title></h3>
    <p data-recipe-intro></p>
    <p class="recipe-time" data-recipe-time></p>
    <h4 data-recipe-ingredients-heading>Ingredients</h4>
    <ul data-recipe-ingredients></ul>
    <h4 data-recipe-method-heading>Method</h4>
    <ol data-recipe-steps></ol>
  </div>
</dialog>
<script>
  import { apiPost, ApiError } from '../data/api';
  import type { Recipe } from './recipePdf';
  import { setMealName } from '../scripts/meal-names';

  const menu = document.querySelector<HTMLElement>('[data-recipe-menu]')!;
  const menuCommand = menu.querySelector<HTMLButtonElement>('[data-recipe-open]')!;
  const dialog = document.querySelector<HTMLDialogElement>('[data-recipe-dialog]')!;
  const dishHeading = dialog.querySelector<HTMLElement>('[data-recipe-dish]')!;
  const status = dialog.querySelector<HTMLElement>('[data-recipe-status]')!;
  const result = dialog.querySelector<HTMLElement>('[data-recipe-result]')!;
  const servingsInput = dialog.querySelector<HTMLInputElement>('[data-recipe-servings]')!;
  const generateButton = dialog.querySelector<HTMLButtonElement>('[data-recipe-generate]')!;
  const downloadButton = dialog.querySelector<HTMLButtonElement>('[data-recipe-download]')!;
  let trigger: HTMLButtonElement | null = null;
  let selected: { name: string; description: string; diet: string } | null = null;
  let recipe: Recipe | null = null;
  let loading = false;
  let requestId = 0;

  const labels = {
    en: { action: 'Recreate as recipe', kicker: 'AI recipe', close: 'Close', disclaimer: 'Inspired by the dish, not its official recipe. Check ingredients and allergens yourself.', servings: 'Servings', generate: 'Generate recipe', regenerate: 'Regenerate', generating: 'Creating your recipe…', missing: 'Recipe generation is not configured yet. Add OPENAI_API_KEY to the backend and restart it.', failed: 'Could not create a recipe right now. Please try again.', pdfFailed: 'Could not download the PDF. Please try again.', rate: 'Please wait a little before generating another recipe.', ingredients: 'Ingredients', method: 'Method', download: 'Download PDF', minute: 'min' },
    de: { action: 'Als Rezept nachkochen', kicker: 'KI-Rezept', close: 'Schließen', disclaimer: 'Vom Gericht inspiriert, kein Originalrezept. Zutaten und Allergene selbst prüfen.', servings: 'Portionen', generate: 'Rezept erstellen', regenerate: 'Neu erstellen', generating: 'Rezept wird erstellt…', missing: 'Die Rezepterstellung ist noch nicht eingerichtet. OPENAI_API_KEY im Backend setzen und es neu starten.', failed: 'Das Rezept konnte gerade nicht erstellt werden. Bitte erneut versuchen.', pdfFailed: 'Das PDF konnte nicht heruntergeladen werden. Bitte erneut versuchen.', rate: 'Bitte kurz warten, bevor du ein weiteres Rezept erstellst.', ingredients: 'Zutaten', method: 'Zubereitung', download: 'PDF herunterladen', minute: 'Min.' },
  };
  const language = (): 'en' | 'de' => document.documentElement.lang === 'de' ? 'de' : 'en';
  const t = () => labels[language()];

  function translate(): void {
    menuCommand.textContent = t().action;
    dialog.querySelector<HTMLElement>('[data-recipe-kicker]')!.textContent = t().kicker;
    dialog.querySelector<HTMLElement>('[data-recipe-disclaimer]')!.textContent = t().disclaimer;
    dialog.querySelector<HTMLElement>('[data-recipe-servings-label]')!.textContent = t().servings;
    dialog.querySelector<HTMLElement>('[data-recipe-ingredients-heading]')!.textContent = t().ingredients;
    dialog.querySelector<HTMLElement>('[data-recipe-method-heading]')!.textContent = t().method;
    dialog.querySelector<HTMLButtonElement>('[data-recipe-close]')!.setAttribute('aria-label', t().close);
    generateButton.textContent = recipe ? t().regenerate : t().generate;
    downloadButton.textContent = t().download;
    document.querySelectorAll<HTMLButtonElement>('[data-recipe-trigger]').forEach(button => {
      const label = `${t().action}: ${button.dataset.recipeName ?? ''}`;
      button.setAttribute('aria-label', label);
      button.title = label;
    });
    if (recipe) dialog.querySelector<HTMLElement>('[data-recipe-time]')!.textContent = `${recipe.servings} ${t().servings.toLowerCase()} · ${recipe.minutes} ${t().minute}`;
  }

  function closeMenu(restoreFocus = false): void {
    menu.hidden = true;
    trigger?.setAttribute('aria-expanded', 'false');
    if (restoreFocus) trigger?.focus();
    trigger = null;
  }

  function openMenu(button: HTMLButtonElement): void {
    closeMenu();
    trigger = button;
    button.setAttribute('aria-expanded', 'true');
    const rect = button.getBoundingClientRect();
    menu.hidden = false;
    const width = menu.offsetWidth;
    menu.style.left = `${Math.max(8, Math.min(rect.left, window.innerWidth - width - 8))}px`;
    menu.style.top = `${rect.bottom + 5 + menu.offsetHeight > window.innerHeight ? Math.max(8, rect.top - menu.offsetHeight - 5) : rect.bottom + 5}px`;
    menuCommand.focus();
  }

  async function generate(): Promise<void> {
    if (!selected || loading) return;
    const currentRequest = ++requestId;
    const servings = Number(servingsInput.value);
    if (!Number.isInteger(servings) || servings < 1 || servings > 8) { servingsInput.reportValidity(); return; }
    loading = true;
    recipe = null;
    result.hidden = true;
    generateButton.disabled = true;
    servingsInput.disabled = true;
    status.textContent = t().generating;
    try {
      const generated = await apiPost<Recipe>('/api/recipes', { ...selected, servings, language: language() }, undefined, 55000);
      if (currentRequest !== requestId || !dialog.open) return;
      if (!generated.title || !Array.isArray(generated.ingredients) || !Array.isArray(generated.steps)) throw new Error('Invalid recipe');
      recipe = generated;
      dialog.querySelector<HTMLElement>('[data-recipe-title]')!.textContent = generated.title;
      dialog.querySelector<HTMLElement>('[data-recipe-intro]')!.textContent = generated.intro;
      const ingredients = dialog.querySelector<HTMLUListElement>('[data-recipe-ingredients]')!;
      const steps = dialog.querySelector<HTMLOListElement>('[data-recipe-steps]')!;
      ingredients.replaceChildren(...generated.ingredients.map(entry => {
        const li = document.createElement('li'); li.textContent = `${entry.amount} ${entry.item}`; return li;
      }));
      steps.replaceChildren(...generated.steps.map(step => {
        const li = document.createElement('li'); li.textContent = step; return li;
      }));
      status.textContent = '';
      result.hidden = false;
    } catch (error) {
      if (currentRequest !== requestId || !dialog.open) return;
      status.textContent = error instanceof ApiError && error.status === 503 ? t().missing
        : error instanceof ApiError && error.status === 429 ? t().rate : t().failed;
    } finally {
      if (currentRequest === requestId) {
        loading = false;
        generateButton.disabled = false;
        servingsInput.disabled = false;
        translate();
      }
    }
  }

  document.addEventListener('click', event => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('[data-recipe-trigger]');
    if (button) { event.preventDefault(); if (button === trigger) closeMenu(true); else openMenu(button); return; }
    if (!menu.hidden && !menu.contains(target)) closeMenu();
  });
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && !menu.hidden) { closeMenu(true); event.preventDefault(); } });
  window.addEventListener('scroll', () => { if (!menu.hidden) closeMenu(); }, true);
  window.addEventListener('resize', () => { if (!menu.hidden) closeMenu(); });
  menuCommand.addEventListener('click', () => {
    if (!trigger) return;
    requestId++;
    loading = false;
    generateButton.disabled = false;
    servingsInput.disabled = false;
    selected = { name: trigger.dataset.recipeName ?? '', description: trigger.dataset.recipeDescription ?? '', diet: trigger.dataset.recipeDiet ?? 'meat' };
    closeMenu();
    setMealName(dishHeading, selected.name);
    status.textContent = '';
    result.hidden = true;
    recipe = null;
    servingsInput.value = '2';
    translate();
    dialog.showModal();
    generateButton.focus();
  });
  dialog.querySelector<HTMLButtonElement>('[data-recipe-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => { requestId++; loading = false; generateButton.disabled = false; servingsInput.disabled = false; });
  generateButton.addEventListener('click', () => void generate());
  servingsInput.addEventListener('input', () => { recipe = null; result.hidden = true; translate(); });
  downloadButton.addEventListener('click', async () => {
    if (!recipe) return;
    try {
      const { downloadRecipePdf } = await import('./recipePdf');
      await downloadRecipePdf(recipe, language());
    } catch { status.textContent = t().pdfFailed; }
  });
  document.addEventListener('languagechange', translate);
  translate();
</script>
<style>
  .recipe-menu[hidden],.recipe-result[hidden]{display:none}
  .recipe-menu{position:fixed;z-index:1001;min-width:200px;padding:5px;border:1px solid var(--line);border-radius:8px;background:var(--paper);box-shadow:var(--shadow)}
  .recipe-menu button{width:100%;min-height:40px;padding:8px 12px;border:0;border-radius:5px;background:transparent;color:var(--ink);font:600 14px 'DM Sans',sans-serif;text-align:left;cursor:pointer}
  .recipe-menu button:hover,.recipe-menu button:focus-visible{background:color-mix(in srgb,var(--green) 12%,var(--paper));outline:0}
  .recipe-dialog{box-sizing:border-box;width:min(600px,calc(100vw - 28px));max-height:min(85vh,800px);padding:24px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink);box-shadow:0 24px 70px #0004}
  .recipe-dialog::backdrop{background:#13241bcc;backdrop-filter:blur(3px)}
  .recipe-dialog-head{display:flex;align-items:flex-start;gap:12px}.recipe-dialog-head>div{flex:1;min-width:0}
  .recipe-kicker{margin:0 0 5px;color:var(--green);font-size:11px;font-weight:700;text-transform:uppercase}
  .recipe-dialog h2{margin:0;font-size:24px;line-height:1.25;overflow-wrap:anywhere}.recipe-close{flex:0 0 40px;width:40px;height:40px;border:1px solid var(--line);border-radius:6px;background:transparent;color:var(--ink);font-size:25px;cursor:pointer}
  .recipe-disclaimer{margin:14px 0;color:var(--muted);font-size:13px;line-height:1.5}
  .recipe-controls{display:flex;align-items:center;gap:10px;padding:14px 0 0;border-top:1px solid var(--line)}
  .recipe-controls label{font-size:13px;font-weight:700}.recipe-controls input{width:62px;min-height:40px;padding:4px 8px;border:1px solid var(--line);border-radius:6px;background:var(--paper);color:var(--ink);font:600 15px 'DM Sans',sans-serif}
  .recipe-controls button,.recipe-result-actions button{min-height:40px;padding:8px 14px;border-radius:6px;font:700 13px 'DM Sans',sans-serif;cursor:pointer}
  .recipe-controls button{border:0;background:var(--green);color:var(--paper)}
  .recipe-result-actions button{border:1px solid color-mix(in srgb,var(--green) 55%,var(--line));background:color-mix(in srgb,var(--green) 10%,var(--paper));color:var(--green)}
  .recipe-result-actions button:hover{background:color-mix(in srgb,var(--green) 18%,var(--paper))}
  .recipe-controls button{margin-left:auto}.recipe-controls button:disabled{opacity:.6;cursor:wait}
  .recipe-status{min-height:18px;margin:14px 0;color:var(--muted);font-size:13px;line-height:1.5}
  .recipe-status:empty{min-height:0;margin:0}
  .recipe-result-actions{display:flex;justify-content:center;margin:18px 0 20px}
  .recipe-result h3{margin:0 0 7px;font-size:18px}.recipe-result h4{margin:18px 0 8px;font-size:14px}.recipe-result p,.recipe-result li{font-size:14px;line-height:1.55}.recipe-result ul,.recipe-result ol{padding-left:22px}.recipe-result li{margin-bottom:5px}.recipe-time{color:var(--green);font-weight:700}
  .recipe-dialog button:focus-visible,.recipe-dialog input:focus-visible{outline:3px solid var(--green);outline-offset:2px}
  @media(max-width:500px){.recipe-dialog{padding:18px}.recipe-dialog h2{font-size:20px}.recipe-controls{flex-wrap:wrap}.recipe-controls button,.recipe-result-actions button{width:100%;margin-left:0}}
</style>
