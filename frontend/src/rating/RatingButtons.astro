<div data-rating-step="rate" hidden>
  <p data-rating-meal-name></p>
  <h3 tabindex="-1" data-rating-rate-heading>How was your meal?</h3>
  <div class="meal-rating-scores">
    <button type="button" data-rating-score="1"><span aria-hidden="true">👎</span>Not for me</button>
    <button type="button" data-rating-score="2"><span aria-hidden="true">👌</span>Fine</button>
    <button type="button" data-rating-score="3"><span aria-hidden="true">♥</span>Loved it</button>
  </div>
  <button type="button" data-rating-back="meal">Back to meals</button>
</div>
