---
const scores = [
  { stars: 1, label: 'Not for me' },
  { stars: 2, label: 'Meh' },
  { stars: 3, label: 'Fine' },
  { stars: 4, label: 'Good' },
  { stars: 5, label: 'Loved it' },
];
---
<div data-rating-step="rate" hidden>
  <p data-rating-meal-name></p>
  <h3 tabindex="-1" data-rating-rate-heading data-rating-text="rate">How was your meal?</h3>
  <div class="meal-rating-scores" role="group" data-rating-aria="scores" aria-label="Rate from 1 to 5 stars">
    {scores.map(({ stars, label }) => (
      <button type="button" data-rating-score={stars} aria-label={`${stars} of 5 stars: ${label}`}>
        <span aria-hidden="true">{stars}★</span><strong data-rating-text={`score${stars}`}>{label}</strong>
      </button>
    ))}
  </div>
  <button type="button" data-rating-back="meal" data-rating-text="backMeals">Back to meals</button>
</div>
