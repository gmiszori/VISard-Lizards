<div data-rating-step="mensa">
  <p>Did you eat at one of these?</p>
  <div class="meal-rating-options" data-rating-mensas></div>
  <div class="meal-rating-options">
    <button type="button" data-rating-other>Other mensa</button>
    <button type="button" data-rating-skip>No / skip</button>
  </div>
  <div hidden data-rating-other-picker>
    <label for="meal-rating-mensa">Choose a mensa</label>
    <select id="meal-rating-mensa" data-rating-mensa-select><option value="">Choose a mensa…</option></select>
    <button type="button" data-rating-mensa-confirm>Continue</button>
  </div>
</div>
