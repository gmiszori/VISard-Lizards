# Copy to .env to configure the frontend.

# CampusEats backend (backend/, `./mvnw spring-boot:run`). Menus, ratings and crowd predictions come from here.
# By default, browser requests use the current origin and Astro proxies /api to the local backend;
# the static build reads http://localhost:8080. Set a URL only when the API runs elsewhere.
# An explicit empty value uses only built-in sample data.
# PUBLIC_API_URL=https://api.example.org
