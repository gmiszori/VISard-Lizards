{
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXY_RANGES}
	}
}

:8080 {
	root * /srv
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
	}

	reverse_proxy /api/* backend:8080
	reverse_proxy /swagger-ui* backend:8080
	reverse_proxy /v3/api-docs* backend:8080

	file_server
}
